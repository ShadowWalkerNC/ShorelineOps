---
import BaseLayout from '../layouts/BaseLayout.astro'

const DEMO_URL = import.meta.env.PUBLIC_DEMO_URL || 'https://shoreline-demo.onrender.com/menu'
---

<BaseLayout title="Transparent Pricing — Free Software & Paid SaaS" description="Free open-source community core software. Paid managed cloud SaaS for multi-distributor split ordering, PointClickCare EHR integration, and CMS-2567 compliance.">
  <section class="py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-14">
        <div class="inline-block px-3.5 py-1 bg-blue-50 dark:bg-blue-950/70 border border-blue-200/70 dark:border-blue-800/60 rounded-full text-blue-600 dark:text-blue-400 text-xs font-semibold uppercase tracking-wider mb-4 font-mono">
          Free Core Software · Paid SaaS
        </div>
        <h1 class="text-3xl sm:text-5xl font-bold text-slate-900 dark:text-white tracking-tight mb-4">
          Free Software for Every Kitchen. <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-teal-500 to-emerald-600 dark:from-blue-400 dark:via-teal-300 dark:to-emerald-400">Paid Cloud SaaS When You Grow.</span>
        </h1>
        <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400">
          The core platform is 100% free and open-source under AGPL/Apache. Upgrade to managed cloud SaaS for automated distributor ordering and EHR integrations.
        </p>
      </div>

      <!-- Pricing Cards Grid (Apple HIG Style) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto mb-16">
        
        <!-- Tier 1: Free Community Core -->
        <div class="p-6 sm:p-8 rounded-3xl bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800/80 flex flex-col justify-between hover:border-slate-300 transition-all shadow-apple-card">
          <div>
            <div class="inline-block px-2.5 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 text-[11px] font-bold font-mono uppercase mb-3 border border-emerald-200/60 dark:border-emerald-800/40">
              100% Free Forever
            </div>
            <div class="text-slate-900 dark:text-white font-bold text-lg mb-1">Community Core</div>
            <div class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white mb-2">$0 <span class="text-xs text-slate-400 font-normal">/ month</span></div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mb-6">Full open-source software stack for independent care facilities and community kitchens.</p>
            
            <ul class="space-y-2.5 text-xs text-slate-600 dark:text-slate-300 border-t border-slate-100 dark:border-slate-800 pt-5 mb-6">
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> <strong>Unlimited Resident Profiles</strong></li>
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> Full IDDSI & Dysphagia Texture Rules</li>
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> Weekly Menu Cycle Planner</li>
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> High-Contrast Tray Card Printing</li>
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> Kitchen Tablet Mode Worksheets</li>
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> Self-Hosted Docker Compose Stack</li>
            </ul>
          </div>

          <a
            href="https://github.com/ShadowWalkerNC/ShorelineOps"
            target="_blank"
            rel="noreferrer"
            class="w-full py-2.5 text-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-900 dark:text-white font-semibold rounded-xl text-xs transition-all"
          >
            Get Free Core (GitHub) &rarr;
          </a>
        </div>

        <!-- Tier 2: Managed Pro Cloud SaaS -->
        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border-2 border-blue-500 flex flex-col justify-between relative shadow-apple-elevated">
          <div class="absolute -top-3 right-6 px-3 py-0.5 bg-blue-600 text-white text-[10px] font-bold uppercase tracking-wider rounded-full shadow-xs font-mono">
            Most Popular SaaS
          </div>

          <div>
            <div class="inline-block px-2.5 py-0.5 rounded-full bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-400 text-[11px] font-bold font-mono uppercase mb-3 border border-blue-200/60 dark:border-blue-800/40">
              Managed Cloud
            </div>
            <div class="text-blue-600 dark:text-blue-400 font-bold text-lg mb-1">Pro Cloud SaaS</div>
            <div class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white mb-2">$199 <span class="text-xs text-slate-400 font-normal">/ mo per facility</span></div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mb-6">Zero-maintenance managed cloud with automated multi-distributor split ordering and tray scanning.</p>
            
            <ul class="space-y-2.5 text-xs text-slate-700 dark:text-slate-200 border-t border-slate-100 dark:border-slate-800 pt-5 mb-6">
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> <strong>Everything in Free Core, plus:</strong></li>
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> <strong>Multi-Distributor Split MRP (Dennis, Sysco, US Foods)</strong></li>
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> <strong>Digital Tray Scanner PWA</strong> with live IDDSI verification</li>
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> Live Cost Per Resident Day ($/CPD) Auditing</li>
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> Automated Cloud Backups & Offline Sync</li>
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> Signed Business Associate Agreement (BAA)</li>
            </ul>
          </div>

          <a
            href={DEMO_URL}
            target="_blank"
            rel="noreferrer"
            class="w-full py-2.5 text-center bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-xl text-xs transition-all shadow-sm shadow-blue-600/30"
          >
            Launch 30-Day Pro Pilot &rarr;
          </a>
        </div>

        <!-- Tier 3: Enterprise Care Network SaaS -->
        <div class="p-6 sm:p-8 rounded-3xl bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800/80 flex flex-col justify-between hover:border-slate-300 transition-all shadow-apple-card">
          <div>
            <div class="inline-block px-2.5 py-0.5 rounded-full bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-400 text-[11px] font-bold font-mono uppercase mb-3 border border-purple-200/60 dark:border-purple-800/40">
              Enterprise Care
            </div>
            <div class="text-slate-900 dark:text-white font-bold text-lg mb-1">Enterprise Care Network</div>
            <div class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white mb-2">$399 <span class="text-xs text-slate-400 font-normal">/ mo per facility</span></div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mb-6">For multi-facility care campuses requiring live EHR sync, CMS survey binders, and invoice audits.</p>
            
            <ul class="space-y-2.5 text-xs text-slate-600 dark:text-slate-300 border-t border-slate-100 dark:border-slate-800 pt-5 mb-6">
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> <strong>Everything in Pro Cloud SaaS, plus:</strong></li>
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> <strong>PointClickCare EHR Bi-Directional Auto-Sync</strong></li>
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> <strong>1-Click CMS-2567 Federal Survey Audit Binder</strong></li>
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> 3-Way Invoice Match & Vendor Credit Claim Generator</li>
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> Multi-Facility Central Menu Planning</li>
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> 24/7 Priority Support & Dietitian SLA</li>
            </ul>
          </div>

          <a
            href="mailto:support@shorelineops.com"
            class="w-full py-2.5 text-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-900 dark:text-white font-semibold rounded-xl text-xs transition-all"
          >
            Contact Enterprise Team &rarr;
          </a>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
