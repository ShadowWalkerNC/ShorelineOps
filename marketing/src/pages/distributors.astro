---
import BaseLayout from '../layouts/BaseLayout.astro'

const DEMO_URL = import.meta.env.PUBLIC_DEMO_URL || 'https://shoreline-demo.onrender.com/distributor'
---

<BaseLayout title="For Food Distributors (Dennis & Sysco Reps)" description="How ShorelineOps drives higher standing-order volume, eliminates customer churn, and provides distributor reps with dedicated portal tools.">
  <section class="py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Header Banner */}
      <div class="max-w-3xl mx-auto text-center mb-14">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 bg-amber-50 dark:bg-amber-950/70 border border-amber-200/70 dark:border-amber-800/60 rounded-full text-amber-700 dark:text-amber-400 text-xs font-semibold uppercase tracking-wider mb-4 font-mono shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
          <span>Broadline Vendor Ecosystem</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
          Turn Healthcare Kitchens into <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-600 via-orange-500 to-amber-500 dark:from-amber-400 dark:via-orange-300 dark:to-amber-200">High-Volume Standing Accounts.</span>
        </h1>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
          When assisted living kitchens guess inventory on clipboards, order volumes fluctuate and emergency run-outs occur. ShorelineOps dynamically explodes cycle menus into precise case-pack POs directly linked to your distributor item SKUs.
        </p>
      </div>

      <!-- Distributor Partner Live Telemetry Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-14 max-w-5xl mx-auto">
        <div class="p-5 rounded-2xl bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800/80 shadow-apple-subtle">
          <div class="flex items-center justify-between mb-3">
            <span class="font-bold text-sm text-slate-900 dark:text-white">Dennis Food Service</span>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400 border border-emerald-200/60 font-mono">PRIMARY</span>
          </div>
          <div class="text-2xl font-bold text-slate-900 dark:text-white mb-1 font-sans">142 SKUs</div>
          <div class="text-xs text-slate-500 dark:text-slate-400">Weekly Truck Delivery: Tuesday / Friday</div>
        </div>

        <div class="p-5 rounded-2xl bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800/80 shadow-apple-subtle">
          <div class="flex items-center justify-between mb-3">
            <span class="font-bold text-sm text-slate-900 dark:text-white">Sysco Corporation</span>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 dark:bg-blue-950/80 text-blue-600 dark:text-blue-400 border border-blue-200/60 font-mono">SECONDARY</span>
          </div>
          <div class="text-2xl font-bold text-slate-900 dark:text-white mb-1 font-sans">89 SKUs</div>
          <div class="text-xs text-slate-500 dark:text-slate-400">Contract Price Sync: Active IMPAC</div>
        </div>

        <div class="p-5 rounded-2xl bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800/80 shadow-apple-subtle">
          <div class="flex items-center justify-between mb-3">
            <span class="font-bold text-sm text-slate-900 dark:text-white">US Foods</span>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-purple-50 dark:bg-purple-950/80 text-purple-600 dark:text-purple-400 border border-purple-200/60 font-mono">SUPPLEMENTAL</span>
          </div>
          <div class="text-2xl font-bold text-slate-900 dark:text-white mb-1 font-sans">34 SKUs</div>
          <div class="text-xs text-slate-500 dark:text-slate-400">Produce & Specialty Backup</div>
        </div>
      </div>

      <!-- 3 Key Distributor Value Props -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16 max-w-6xl mx-auto">
        <div class="p-6 sm:p-8 rounded-3xl bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800/80 hover:border-amber-500/40 transition-all shadow-apple-card">
          <div class="text-3xl mb-3">📈</div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white mb-1.5">Higher, Predictable Order Volume</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Facilities using Shoreline's suggested MRP order generator maintain strict par levels, ordering weekly truck deliveries without skipping replenishment cycles.
          </p>
        </div>

        <div class="p-6 sm:p-8 rounded-3xl bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800/80 hover:border-amber-500/40 transition-all shadow-apple-card">
          <div class="text-3xl mb-3">⚡</div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white mb-1.5">Zero IT Integration Headaches</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            No expensive custom EDI development or proprietary hardware required. Reps simply provide standard CSV order guides and receive clean, formatted purchase orders.
          </p>
        </div>

        <div class="p-6 sm:p-8 rounded-3xl bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800/80 hover:border-amber-500/40 transition-all shadow-apple-card">
          <div class="text-3xl mb-3">🛡️</div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white mb-1.5">Dedicated Rep Portal (`/distributor`)</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Sales reps get direct portal access to update item SKUs, pack sizes, and contract unit pricing—keeping order guides up to date with zero friction.
          </p>
        </div>
      </div>

      <!-- Live Interactive Visual Showcase -->
      <div class="max-w-5xl mx-auto mb-16 p-6 sm:p-8 rounded-3xl bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800/80 shadow-apple-card">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
          <div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white tracking-tight">Split MRP Price Comparator & PO Optimizer</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Automated line-item contract rate resolution across Dennis, Sysco, and US Foods</p>
          </div>
          <a
            href="https://shoreline-demo.onrender.com/purchasing"
            target="_blank"
            rel="noreferrer"
            class="text-xs font-semibold px-3.5 py-1.5 rounded-xl bg-blue-50 dark:bg-blue-950/80 text-blue-600 dark:text-blue-400 border border-blue-200/60 dark:border-blue-800/60 hover:bg-blue-100 transition-colors"
          >
            Launch Live MRP Engine &rarr;
          </a>
        </div>
        <div class="rounded-2xl overflow-hidden border border-slate-200/80 dark:border-slate-800/80 shadow-apple-subtle">
          <img src="/screenshots/split_mrp_purchasing.jpg" alt="Split MRP Comparator" class="w-full h-auto object-cover" />
        </div>
      </div>

      <!-- How Dennis Reps Use It -->
      <div class="max-w-4xl mx-auto p-8 sm:p-10 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800/80 text-center shadow-apple-card">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-2 font-sans">Are you a Dennis or Sysco Healthcare Sales Rep?</h2>
        <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm max-w-xl mx-auto mb-6 leading-relaxed">
          We provide free onboarding support for any regional healthcare account. We'll format your customer's order guide and pre-load their par levels in under 24 hours.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href={DEMO_URL}
            target="_blank"
            rel="noreferrer"
            class="w-full sm:w-auto px-6 py-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-xl text-xs sm:text-sm transition-all shadow-sm shadow-amber-500/20"
          >
            Explore the Distributor Portal (`/distributor`) &rarr;
          </a>
          <a
            href="https://shoreline-demo.onrender.com/enterprise"
            target="_blank"
            rel="noreferrer"
            class="w-full sm:w-auto px-6 py-3 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-bold rounded-xl text-xs sm:text-sm hover:bg-slate-200 transition-all"
          >
            Corporate HQ Portal (`/enterprise`)
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
