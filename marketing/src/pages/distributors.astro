---
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'

const DEMO_URL = import.meta.env.PUBLIC_DEMO_URL || '/demo/distributor'
---

<BaseLayout 
  title="Distributor Ecosystem — Dennis & Sysco Healthcare Procurement" 
  description="How ShorelineOps drives higher standing-order volume, eliminates customer churn, and provides distributor sales reps with dedicated vendor tools."
>
  <section class="marketing-page-intro py-16 sm:py-24 border-b border-slate-200 dark:border-obsidian-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="max-w-3xl mx-auto text-center mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-700 dark:text-amber-300 text-[11px] font-mono uppercase tracking-wider mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
          <span>BROADLINE VENDOR PROCUREMENT MATRIX</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4 font-display">
          Turn Healthcare Kitchens into <br class="hidden sm:inline" />
          <span class="text-amber-600 dark:text-amber-400">High-Volume Standing Accounts.</span>
        </h1>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 leading-relaxed max-w-2xl mx-auto">
          When assisted living kitchens guess inventory on clipboards, order volumes fluctuate and emergency run-outs occur. ShorelineOps dynamically explodes cycle menus into precise case-pack POs directly linked to your distributor item SKUs.
        </p>
      </div>

      <!-- Distributor Live Catalog Matrix (Unified Grid) -->
      <div class="border border-slate-200 dark:border-obsidian-border rounded-xl bg-white dark:bg-obsidian-card shadow-surface divide-y sm:divide-y-0 sm:divide-x divide-slate-200 dark:divide-obsidian-border grid grid-cols-1 sm:grid-cols-3 mb-16">
        <div class="p-6 sm:p-8">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">PRIMARY BROADLINE</span>
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20">
              ACTIVE
            </span>
          </div>
          <div class="text-lg font-bold text-slate-900 dark:text-white font-display mb-1">Dennis Food Service</div>
          <div class="text-3xl font-extrabold text-slate-900 dark:text-white font-mono mb-2">142 <span class="text-xs text-slate-400 font-normal">SKUs</span></div>
          <p class="text-xs text-slate-500 leading-relaxed">
            Maine &amp; New England broadline catalog. Tuesday &amp; Friday delivery schedule with pre-configured order guides.
          </p>
        </div>

        <div class="p-6 sm:p-8">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">SECONDARY BROADLINE</span>
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-blue-500/10 text-blue-700 dark:text-blue-300 border border-blue-500/20">
              SPLIT ACTIVE
            </span>
          </div>
          <div class="text-lg font-bold text-slate-900 dark:text-white font-display mb-1">Sysco Corporation</div>
          <div class="text-3xl font-extrabold text-slate-900 dark:text-white font-mono mb-2">89 <span class="text-xs text-slate-400 font-normal">SKUs</span></div>
          <p class="text-xs text-slate-500 leading-relaxed">
            National enterprise contract rates. Lowest $/oz pureed meats and thickeners via automated EDI price comparisons.
          </p>
        </div>

        <div class="p-6 sm:p-8">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">PRODUCE &amp; DAIRY</span>
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-purple-500/10 text-purple-700 dark:text-purple-300 border border-purple-500/20">
              SUPPLEMENTAL
            </span>
          </div>
          <div class="text-lg font-bold text-slate-900 dark:text-white font-display mb-1">US Foods / Regional</div>
          <div class="text-3xl font-extrabold text-slate-900 dark:text-white font-mono mb-2">34 <span class="text-xs text-slate-400 font-normal">SKUs</span></div>
          <p class="text-xs text-slate-500 leading-relaxed">
            Fresh produce and regional dairy backup orders. Automatically routes lines when primary suppliers stock out.
          </p>
        </div>
      </div>

      <!-- Distributor Operational Advantages -->
      <div class="border border-slate-200 dark:border-obsidian-border rounded-xl bg-white dark:bg-obsidian-card shadow-surface divide-y md:divide-y-0 md:divide-x divide-slate-200 dark:divide-obsidian-border grid grid-cols-1 md:grid-cols-3 mb-16">
        <div class="p-6 sm:p-8">
          <div class="text-xs font-mono font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider mb-2">
            01 / PREDICTABLE VOLUME
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white font-display mb-2">Automated Par Replenishment</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Facilities maintain strict standing par levels. Kitchens order on scheduled cut-offs without skipping replenishment trucks.
          </p>
        </div>

        <div class="p-6 sm:p-8">
          <div class="text-xs font-mono font-bold text-shoreline-600 dark:text-shoreline-400 uppercase tracking-wider mb-2">
            02 / ZERO IT FRICTION
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white font-display mb-2">Simple CSV &amp; EDI Exchange</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            No expensive proprietary EDI adapters required. Reps upload standard CSV price files or connect via SFTP EDI 850/810.
          </p>
        </div>

        <div class="p-6 sm:p-8">
          <div class="text-xs font-mono font-bold text-purple-600 dark:text-purple-400 uppercase tracking-wider mb-2">
            03 / REP PORTAL
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white font-display mb-2">Direct Vendor Dashboard</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Distributor reps log into <code class="px-1 py-0.5 rounded bg-slate-100 dark:bg-obsidian-surface font-mono text-[11px]">/distributor</code> to maintain pack sizes and pricing without accessing confidential resident health data.
          </p>
        </div>
      </div>

      <!-- Screenshot Telemetry Panel -->
      <div class="border border-slate-200 dark:border-obsidian-border rounded-xl bg-white dark:bg-obsidian-card shadow-surface overflow-hidden mb-16">
        <div class="p-6 sm:p-8 border-b border-slate-200 dark:border-obsidian-border flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div class="text-xs font-mono font-bold uppercase tracking-wider text-slate-400 mb-1">LIVE PROCUREMENT ENGINE</div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white font-display">Split MRP Price Comparator &amp; PO Optimizer</h3>
          </div>
          <a
            href={DEMO_URL}
            class="py-2 px-3.5 rounded-lg bg-shoreline-600 hover:bg-shoreline-700 text-white text-xs font-semibold font-mono uppercase tracking-wider shadow-sm transition-colors inline-flex items-center gap-1.5 self-start sm:self-auto"
          >
            <span>Open Vendor Portal</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5" />
          </a>
        </div>
        <div class="bg-black">
          <img src="/screenshots/split_mrp_purchasing.jpg" alt="Split MRP Comparator" class="w-full h-auto object-cover opacity-95" />
        </div>
      </div>

      <!-- Call to Action Banner -->
      <div class="border border-slate-200 dark:border-obsidian-border rounded-xl p-8 bg-slate-50/60 dark:bg-obsidian-surface/60 text-center">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-display mb-2">
          Are you a Dennis or Sysco Healthcare Sales Rep?
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-xl mx-auto mb-6 leading-relaxed">
          We provide free onboarding support for any regional healthcare account. We will format your customer order guide and pre-load par levels in under 24 hours.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href={DEMO_URL}
            class="w-full sm:w-auto py-2.5 px-5 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold rounded-lg text-xs font-mono uppercase tracking-wider shadow-sm transition-colors inline-flex items-center justify-center gap-2"
          >
            <span>Explore Vendor Portal</span>
            <Icon name="arrow-right" class="w-4 h-4" />
          </a>
          <a
            href="/pricing"
            class="w-full sm:w-auto py-2.5 px-5 border border-slate-300 dark:border-obsidian-border bg-white dark:bg-obsidian-card hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-900 dark:text-white font-semibold rounded-lg text-xs font-mono uppercase tracking-wider transition-colors"
          >
            Review SaaS Tiers
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
