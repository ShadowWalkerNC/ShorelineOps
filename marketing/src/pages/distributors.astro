---
import BaseLayout from '../layouts/BaseLayout.astro'

const DEMO_URL = import.meta.env.PUBLIC_DEMO_URL || 'https://shoreline-demo.onrender.com/menu'
---

<BaseLayout title="For Food Distributors (Dennis & Sysco Reps)" description="How ShorelineOps drives higher standing-order volume, eliminates customer churn, and provides distributor reps with dedicated portal tools.">
  <section class="py-20 bg-gradient-to-b from-slate-900/80 via-slate-950 to-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <div class="inline-block px-3.5 py-1 bg-amber-950/80 border border-amber-800/60 rounded-full text-amber-400 text-xs font-bold uppercase tracking-wider mb-4 font-mono">
          Broadline Partner Program
        </div>
        <h1 class="text-4xl sm:text-6xl font-display font-black text-white tracking-tight mb-6">
          Turn Dietary Kitchens into <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-orange-300 to-amber-200">High-Volume Standing Accounts.</span>
        </h1>
        <p class="text-lg text-slate-300">
          When assisted living kitchens guess their inventory on clipboards, order volumes fluctuate and emergency shortages happen. ShorelineOps automates par levels so facilities order consistently from their primary distributor.
        </p>
      </div>

      <!-- 3 Key Distributor Value Props -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20 max-w-6xl mx-auto">
        <div class="p-8 rounded-3xl bg-slate-900/70 border border-slate-800 hover:border-amber-500/40 transition-all">
          <div class="text-4xl mb-4">📈</div>
          <h3 class="text-xl font-bold text-white mb-2">Higher, Predictable Order Volume</h3>
          <p class="text-slate-400 text-xs leading-relaxed">
            Facilities using Shoreline's suggested order generator maintain strict par levels, ordering weekly truck deliveries without skipping replenishment cycles.
          </p>
        </div>

        <div class="p-8 rounded-3xl bg-slate-900/70 border border-slate-800 hover:border-amber-500/40 transition-all">
          <div class="text-4xl mb-4">⚡</div>
          <h3 class="text-xl font-bold text-white mb-2">Zero IT Integration Headaches</h3>
          <p class="text-slate-400 text-xs leading-relaxed">
            No expensive custom EDI development or proprietary hardware required. Reps simply provide standard CSV order guides and receive clean purchase orders.
          </p>
        </div>

        <div class="p-8 rounded-3xl bg-slate-900/70 border border-slate-800 hover:border-amber-500/40 transition-all">
          <div class="text-4xl mb-4">🛡️</div>
          <h3 class="text-xl font-bold text-white mb-2">Dedicated Rep Portal (`/distributor`)</h3>
          <p class="text-slate-400 text-xs leading-relaxed">
            Sales reps get free direct portal access to update item SKUs, pack sizes, and contract unit pricing—keeping order guides up to date with zero friction.
          </p>
        </div>
      </div>

      <!-- How Dennis Reps Use It -->
      <div class="max-w-4xl mx-auto p-10 rounded-3xl bg-white/5 backdrop-blur-xl border border-slate-800 text-center shadow-xl">
        <h2 class="text-2xl font-bold text-white mb-4">Are you a Dennis or Sysco Healthcare Sales Rep?</h2>
        <p class="text-slate-300 text-sm max-w-2xl mx-auto mb-6 leading-relaxed">
          We provide free onboarding support for any regional healthcare account. We'll format your customer's order guide and pre-load their par levels in under 24 hours.
        </p>
        <a href={`${DEMO_URL}/distributor`} target="_blank" rel="noreferrer" class="inline-flex px-8 py-3.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-2xl text-xs transition-all shadow-lg shadow-amber-500/20">
          Explore the Distributor Portal (`/distributor`) &rarr;
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

