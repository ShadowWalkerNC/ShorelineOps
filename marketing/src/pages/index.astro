---
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'
import Logo from '../components/Logo.astro'

const DEMO_URL = import.meta.env.PUBLIC_DEMO_URL || '/demo'
---

<BaseLayout title="Healthcare Dietary & Clinical Nutrition Platform">
  
  <!-- HERO SECTION -->
  <!-- HERO SECTION -->
  <section class="relative pt-10 sm:pt-18 pb-16 sm:pb-24 overflow-hidden">
    <!-- Ambient Gradient Backdrops -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] sm:w-[850px] h-[350px] bg-gradient-to-tr from-blue-500/15 via-teal-400/15 to-purple-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      
      <!-- Eyebrow Pill Badge: Clear, honest identity -->
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border border-slate-200/90 dark:border-slate-800/80 text-slate-800 dark:text-slate-200 text-xs font-semibold mb-6 shadow-xs font-mono">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="text-blue-600 dark:text-blue-400 font-bold">CARE OS</span>
        <span class="text-slate-300 dark:text-slate-700">|</span>
        <span>Open-Source Healthcare Dietary Software</span>
      </div>

      <!-- Main Headline: Plain, direct value proposition -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight max-w-4xl mx-auto leading-[1.12] mb-5 font-sans">
        Kitchen Management and Resident Diet Safety — <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-teal-500 to-emerald-600 dark:from-blue-400 dark:via-teal-300 dark:to-emerald-400">Without the Complexity.</span>
      </h1>

      <!-- Subtitle: Plain English, no unbacked statistics, no cryptic acronyms -->
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-3xl mx-auto mb-8 font-normal leading-relaxed">
        Built for senior living dining rooms and healthcare kitchens. Plan 4-week cycle menus, track resident diet textures and allergies, log food temperatures, and compare food distributor prices side-by-side. Free to download and run on your own computer, or sign up for our fully managed cloud service.
      </p>

      <!-- Primary Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 max-w-2xl mx-auto mb-5">
        <a
          href={DEMO_URL}
          class="w-full sm:w-auto px-7 py-3.5 bg-gradient-to-r from-blue-600 to-teal-600 hover:from-blue-500 hover:to-teal-500 text-white font-bold rounded-xl text-xs sm:text-sm transition-all shadow-md shadow-blue-600/25 inline-flex items-center justify-center gap-2 hover:scale-[1.02] active:scale-[0.98]"
        >
          <Icon name="sparkles" class="w-4 h-4 text-amber-300" />
          <span>Try Interactive Demo</span>
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
        <a
          href="/pricing"
          class="w-full sm:w-auto px-5 py-3.5 bg-white/90 dark:bg-slate-900/90 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-800 font-semibold rounded-xl text-xs sm:text-sm transition-all inline-flex items-center justify-center gap-2 shadow-xs"
        >
          <Icon name="layers" class="w-4 h-4 text-blue-600 dark:text-blue-400" />
          <span>View Plans & Pricing</span>
        </a>
        <a
          href="https://github.com/ShadowWalkerNC/ShorelineOps"
          target="_blank"
          rel="noreferrer"
          class="w-full sm:w-auto px-5 py-3.5 bg-slate-900 hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-100 text-white dark:text-slate-900 font-semibold rounded-xl text-xs sm:text-sm transition-all inline-flex items-center justify-center gap-2 shadow-xs hover:scale-[1.02] active:scale-[0.98]"
        >
          <Icon name="github" class="w-4 h-4 text-white dark:text-slate-900" />
          <span>Free Local Version (GitHub)</span>
        </a>
      </div>

      <!-- Trust Badges: Honest, verifiable capabilities -->
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-slate-500 dark:text-slate-400 font-mono mb-12">
        <span class="inline-flex items-center gap-1.5"><Icon name="check" class="w-3.5 h-3.5 text-emerald-500" /> 100% Free Open-Source Core</span>
        <span class="inline-flex items-center gap-1.5"><Icon name="check" class="w-3.5 h-3.5 text-emerald-500" /> Runs offline on your kitchen computer or tablet</span>
        <span class="inline-flex items-center gap-1.5"><Icon name="check" class="w-3.5 h-3.5 text-emerald-500" /> No credit card or vendor lock-in</span>
      </div>

      <!-- Real App Interface Showcase -->
      <div class="max-w-5xl mx-auto mb-12 rounded-3xl overflow-hidden border border-slate-200/80 dark:border-slate-800/80 shadow-apple-elevated bg-white/60 dark:bg-slate-900/60 p-2 sm:p-3">
        <div class="flex items-center justify-between px-3 py-2 border-b border-slate-100 dark:border-slate-800/60 text-xs text-slate-400 font-mono">
          <div class="flex items-center gap-2">
            <div class="flex gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-400/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></span>
            </div>
            <span class="ml-2 truncate text-slate-500 dark:text-slate-400">Shoreline Executive Dashboard</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 text-[10px] font-bold border border-emerald-300/60 dark:border-emerald-800/60 font-mono">STANDALONE &amp; CLOUD READY</span>
          </div>
        </div>
        <img
          src="/screenshots/dashboard_overview.png"
          alt="Shoreline Care OS Executive Dashboard"
          class="w-full h-auto rounded-2xl object-cover"
        />
      </div>

      <!-- 4 Core Capabilities: Practical, grounded benefits -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto text-left">
        <div class="p-5 rounded-2xl bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs">
          <div class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200/60 dark:border-emerald-800/60 flex items-center justify-center text-emerald-600 dark:text-emerald-400 mb-3">
            <Icon name="shield-alert" class="w-4 h-4" />
          </div>
          <div class="text-base font-bold text-slate-900 dark:text-white font-sans">Diet &amp; Allergy Safety</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">Clear alerts for pureed, minced, and soft textures, plus allergy warnings before plates leave the kitchen.</div>
        </div>

        <div class="p-5 rounded-2xl bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs">
          <div class="w-8 h-8 rounded-lg bg-blue-50 dark:bg-blue-950/60 border border-blue-200/60 dark:border-blue-800/60 flex items-center justify-center text-blue-600 dark:text-blue-400 mb-3">
            <Icon name="calendar" class="w-4 h-4" />
          </div>
          <div class="text-base font-bold text-slate-900 dark:text-white font-sans">4-Week Cycle Menus</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">Organize breakfast, lunch, and dinner with daily alternates. Recipes automatically scale ingredient quantities.</div>
        </div>

        <div class="p-5 rounded-2xl bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs">
          <div class="w-8 h-8 rounded-lg bg-rose-50 dark:bg-rose-950/60 border border-rose-200/60 dark:border-rose-800/60 flex items-center justify-center text-rose-600 dark:text-rose-400 mb-3">
            <Icon name="tablet" class="w-4 h-4" />
          </div>
          <div class="text-base font-bold text-slate-900 dark:text-white font-sans">Kitchen Touch Tablet</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">Simple interface with large touch buttons designed for cooks on the line to view orders and log temperatures.</div>
        </div>

        <div class="p-5 rounded-2xl bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs">
          <div class="w-8 h-8 rounded-lg bg-amber-50 dark:bg-amber-950/60 border border-amber-200/60 dark:border-amber-800/60 flex items-center justify-center text-amber-600 dark:text-amber-400 mb-3">
            <Icon name="dollar-sign" class="w-4 h-4" />
          </div>
          <div class="text-base font-bold text-slate-900 dark:text-white font-sans">Price Comparison</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">Compare prices across food distributors side-by-side to avoid paying marked-up prices for kitchen staples.</div>
        </div>
      </div>

    </div>
  </section>

  <!-- COMPARISON: LEGACY CLIPBOARDS VS SHORELINE CARE OS -->
  <section class="py-16 sm:py-20 border-y border-slate-200/80 dark:border-slate-800/80 bg-white/40 dark:bg-slate-900/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
        <div class="text-blue-600 dark:text-blue-400 font-bold text-xs uppercase tracking-wider mb-2 font-mono">The Operating Difference</div>
        <h2 class="text-2xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-3 font-sans">Why Facilities Replace Legacy Software with Shoreline</h2>
        <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm">
          No bloated corporate software contracts. Just clear, reliable tools built by a healthcare executive chef.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        <!-- Old Way -->
        <div class="p-6 sm:p-8 rounded-3xl bg-rose-50/50 dark:bg-rose-950/20 border border-rose-200/60 dark:border-rose-900/40 space-y-4 shadow-xs">
          <div class="text-rose-600 dark:text-rose-400 font-bold text-xs uppercase tracking-wider font-mono">The Old Way (Legacy Monopolies &amp; Clipboards)</div>
          <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">Expensive, Fragile &amp; Survey Risk</h3>
          <ul class="space-y-3 text-xs sm:text-sm text-slate-600 dark:text-slate-300">
            <li class="flex items-start gap-2.5">
              <Icon name="x-circle" class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" />
              <span>Paying $10,000 to $18,000 every single year for legacy proprietary systems with rigid vendor lock-in</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Icon name="x-circle" class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" />
              <span>Ordering exclusively through one food distributor with zero price competition or line-item auditing</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Icon name="x-circle" class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" />
              <span>Faded dry-erase boards and greasy paper clipboards that cooks struggle to read during tray rush</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Icon name="x-circle" class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" />
              <span>Accidental choking risk when a resident's new pureed or minced texture order is missed at the steam table</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Icon name="x-circle" class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" />
              <span>Panic-scrambling through disorganized paper binders when state health inspectors arrive unannounced</span>
            </li>
          </ul>
        </div>

        <!-- ShorelineOps Way -->
        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border-2 border-blue-500/80 space-y-4 relative overflow-hidden shadow-apple-card">
          <div class="text-emerald-600 dark:text-emerald-400 font-bold text-xs uppercase tracking-wider font-mono">The Shoreline Way</div>
          <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">Clinical Rigor, Fair Cost &amp; Chef Ergonomics</h3>
          <ul class="space-y-3 text-xs sm:text-sm text-slate-700 dark:text-slate-200">
            <li class="flex items-start gap-2.5">
              <Icon name="check-circle" class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
              <span><strong>100% Free Open-Source Core:</strong> Full operational suite free forever. Or sign up for our fully managed cloud service — no servers to maintain.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Icon name="check-circle" class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
              <span><strong>Side-by-Side Distributor Price Comparison:</strong> Automatically shows which distributor — Dennis, Sysco, or US Foods — has the lower price on each item.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Icon name="check-circle" class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
              <span><strong>Large Touch Tablet (44px+):</strong> High-contrast buttons designed for line cooks tapping with wet gloves</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Icon name="check-circle" class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
              <span><strong>Deterministic Diet Safety Locks:</strong> Hard blocks prevent serving regular food to pureed or allergen residents</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Icon name="check-circle" class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
              <span><strong>1-Click CMS-2567 Binder (Enterprise):</strong> Complete HACCP temperatures and corrective actions exportable in seconds</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- REAL APPLICATION FEATURES -->
  <section id="features" class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="text-blue-600 dark:text-blue-400 font-bold text-xs uppercase tracking-wider mb-2 font-mono">Platform Architecture</div>
      <h2 class="text-2xl sm:text-4xl font-bold text-slate-900 dark:text-white tracking-tight mb-3 font-sans">
        Everything Your Healthcare Dietary Kitchen Needs
      </h2>
      <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm">
        See the real screens used by dietary managers, clinical dietitians, and line cooks every day.
      </p>
    </div>

    <!-- 1. Menu Cycle Planner -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center mb-16 p-6 sm:p-8 rounded-3xl bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800/80 shadow-apple-card">
      <div class="space-y-4">
        <div class="inline-block px-3 py-1 bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-400 text-xs font-bold font-mono rounded-full border border-amber-200/60">
          1. MENU PLANNING &amp; RECIPES
        </div>
        <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">4-Week Seasonal Cycle Menu Planner</h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Configure 4 weeks of breakfast, lunch, and dinner with daily alternate choices. When you scale a recipe yield, portion sizes and procurement orders calculate automatically.
        </p>
        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-300">
          <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-blue-600 dark:text-blue-400 shrink-0" /> Choice A / Choice B daily resident meal options</li>
          <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-blue-600 dark:text-blue-400 shrink-0" /> Master recipe book with automatic USDA allergen matching</li>
          <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-blue-600 dark:text-blue-400 shrink-0" /> 1-click batch cook sheet printouts with scaled ingredient yields</li>
        </ul>
      </div>
      <div class="rounded-2xl overflow-hidden border border-slate-200/80 dark:border-slate-800/80 shadow-apple-subtle">
        <img src="/screenshots/menu_cycle_planner.png" alt="Shoreline 4-Week Menu Planner" class="w-full h-auto object-cover" />
      </div>
    </div>

    <!-- 2. Clinical Residents Roster -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center mb-16 p-6 sm:p-8 rounded-3xl bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800/80 shadow-apple-card">
      <div class="rounded-2xl overflow-hidden border border-slate-200/80 dark:border-slate-800/80 shadow-apple-subtle order-2 lg:order-1">
        <img src="/screenshots/residents_iddsi_triage.png" alt="Shoreline Residents and Diet Orders" class="w-full h-auto object-cover" />
      </div>
      <div class="space-y-4 order-1 lg:order-2">
        <div class="inline-block px-3 py-1 bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-400 text-xs font-bold font-mono rounded-full border border-blue-200/60">
          2. CLINICAL DIET ORDERS &amp; CENSUS
        </div>
        <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">Resident Diets &amp; IDDSI Texture Orders</h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Maintain active clinical diet orders with zero lag. Track low-sodium, diabetic, renal diets, IDDSI pureed and minced textures, allergen profiles, and dining room seating.
        </p>
        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-300">
          <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0" /> <strong>Census &amp; Diet Order CSV Importer:</strong> Import existing census files in seconds with audit versioning</li>
          <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0" /> IDDSI Level 3, 4, 5, 6 dysphagia texture badges</li>
          <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0" /> Deterministic NPO and allergy stop-warnings</li>
          <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0" /> PointClickCare EHR integration connects directly to your PCC tenant (Enterprise)</li>
        </ul>
      </div>
    </div>

    <!-- 3. Kitchen Tablet Kiosk -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center mb-16 p-6 sm:p-8 rounded-3xl bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800/80 shadow-apple-card">
      <div class="space-y-4">
        <div class="inline-block px-3 py-1 bg-rose-50 dark:bg-rose-950/60 text-rose-700 dark:text-rose-400 text-xs font-bold font-mono rounded-full border border-rose-200/60">
          3. KITCHEN TABLET &amp; HACCP
        </div>
        <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">Gloved Touch Tablet &amp; HACCP Temp Logger</h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Mount an inexpensive tablet directly at the cook station or tray line. Cooks view required portions, record genuine food temps into the tamper-evident HACCP log, and print thermal tray cards.
        </p>
        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-300">
          <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-rose-600 dark:text-rose-400 shrink-0" /> Large 44px+ touch targets designed for gloved cooks</li>
          <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-rose-600 dark:text-rose-400 shrink-0" /> Bluetooth probe support — zero simulated or fake temperatures</li>
          <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-rose-600 dark:text-rose-400 shrink-0" /> 4" x 6" Thermal tray card printing with safe fallback</li>
          <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-rose-600 dark:text-rose-400 shrink-0" /> Durable HACCP logging with mandatory corrective-action notes</li>
        </ul>
      </div>
      <div class="rounded-2xl overflow-hidden border border-slate-200/80 dark:border-slate-800/80 shadow-apple-subtle">
        <img src="/screenshots/kitchen_tablet_kiosk.png" alt="Shoreline Kitchen Touch Tablet" class="w-full h-auto object-cover" />
      </div>
    </div>

    <!-- 4. Split MRP Purchasing -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center mb-16 p-6 sm:p-8 rounded-3xl bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800/80 shadow-apple-card">
      <div class="rounded-2xl overflow-hidden border border-slate-200/80 dark:border-slate-800/80 shadow-apple-subtle order-2 lg:order-1">
        <img src="/screenshots/split_mrp_purchasing.jpg" alt="Split MRP Purchasing Engine" class="w-full h-auto object-cover" />
      </div>
      <div class="space-y-4 order-1 lg:order-2">
        <div class="inline-block px-3 py-1 bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 text-xs font-bold font-mono rounded-full border border-emerald-200/60">
          4. PROCUREMENT &amp; SPLIT MRP
        </div>
        <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">Multi-Distributor Split MRP Ordering</h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Stop overpaying by single-sourcing food. Shoreline explodes cycle menu recipes against current Dennis and Sysco contracted order guides, automatically routing each line item to the lowest-cost distributor.
        </p>
        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-300">
          <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0" /> Line-item contract price comparator across Dennis &amp; Sysco</li>
          <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0" /> Case-pack conversion and rounding logic to eliminate split-case fees</li>
          <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0" /> 3-way invoice match with automated credit claim memos</li>
          <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0" /> Live Cost-Per-Resident-Day ($/CPD) spend tracking</li>
