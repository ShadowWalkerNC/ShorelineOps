---
import BaseLayout from '../layouts/BaseLayout.astro'

const DEMO_URL = import.meta.env.PUBLIC_DEMO_URL || 'https://shoreline-demo.onrender.com'
---

<BaseLayout title="The Care Operations Platform for Senior Living & Healthcare Dietary">
  <!-- HERO SECTION -->
  <section class="relative pt-20 pb-28 overflow-hidden bg-gradient-to-b from-slate-900/80 via-slate-950 to-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      
      <!-- Apple HIG Pill Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-950/80 border border-blue-800/60 text-blue-400 text-xs font-bold mb-8 uppercase tracking-wider font-mono">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Free Open-Source Core · Managed Enterprise SaaS
      </div>

      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-display font-black text-white tracking-tight max-w-5xl mx-auto leading-tight sm:leading-none mb-6">
        Dietary Ops for Healthcare Kitchens That <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-teal-300 to-emerald-400">Actually Cook Real Food.</span>
      </h1>

      <p class="text-lg sm:text-xl text-slate-300 max-w-3xl mx-auto mb-10 font-normal leading-relaxed">
        Connect resident dysphagia textures, tray cards, cycle menus, and <strong>Multi-Distributor split purchasing (Dennis, Sysco, US Foods)</strong> in one touch-optimized platform. Free community software with enterprise cloud integrations.
      </p>

      <!-- Primary CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto mb-16">
        <a href={DEMO_URL} target="_blank" rel="noreferrer" class="w-full sm:w-auto px-8 py-4 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-2xl text-base transition-all shadow-xl shadow-blue-600/30 flex items-center justify-center gap-2 hover:scale-[1.02] active:scale-[0.98]">
          <span>🚀</span> Test Live Interactive Demo
        </a>
        <a href="/pricing" class="w-full sm:w-auto px-8 py-4 bg-slate-900/90 hover:bg-slate-800 text-slate-200 border border-slate-800 font-bold rounded-2xl text-base transition-all flex items-center justify-center">
          Free Core vs SaaS Pricing
        </a>
      </div>

      <!-- Quick Metrics Bar (Apple Glass Cards) -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-5xl mx-auto pt-8 border-t border-slate-800/80 text-left">
        <div class="p-5 rounded-2xl bg-white/5 backdrop-blur-xl border border-slate-800/80 shadow-sm">
          <div class="text-2xl font-display font-black text-blue-400">$1.50–$3.00</div>
          <div class="text-xs text-slate-300 mt-1 font-medium">Saved per resident-day via Lowest-Cost Split MRP</div>
        </div>
        <div class="p-5 rounded-2xl bg-white/5 backdrop-blur-xl border border-slate-800/80 shadow-sm">
          <div class="text-2xl font-display font-black text-emerald-400">100% Free Core</div>
          <div class="text-xs text-slate-300 mt-1 font-medium">Open source MIT software for community facilities</div>
        </div>
        <div class="p-5 rounded-2xl bg-white/5 backdrop-blur-xl border border-slate-800/80 shadow-sm">
          <div class="text-2xl font-display font-black text-amber-400">IDDSI Hard-Blocks</div>
          <div class="text-xs text-slate-300 mt-1 font-medium">Pureed, Minced & Moist, and allergen safety alerts</div>
        </div>
        <div class="p-5 rounded-2xl bg-white/5 backdrop-blur-xl border border-slate-800/80 shadow-sm">
          <div class="text-2xl font-display font-black text-purple-400">PointClickCare Sync</div>
          <div class="text-xs text-slate-300 mt-1 font-medium">Live EHR dietary orders and RD triage queue</div>
        </div>
      </div>
    </div>
  </section>

  <!-- THE INCUMBENT VS SHORELINE VALUE PROPOSITION -->
  <section class="py-20 bg-slate-900/40 border-y border-slate-800/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="text-blue-400 font-bold text-xs uppercase tracking-wider mb-2 font-mono">Market Disruption</div>
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-white mb-4">Why Facilities Are Firing Legacy Software Monopolies</h2>
        <p class="text-slate-400 text-sm sm:text-base">
          Legacy incumbents like MealSuite and CBORD charge $1,200+/month per building, lock you into proprietary vendor contracts, and require 6 months of enterprise onboarding. ShorelineOps provides free software with modern, chef-built workflows.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <!-- Incumbents -->
        <div class="p-8 rounded-3xl bg-red-950/20 border border-red-900/40 space-y-4">
          <div class="text-red-400 font-bold text-xs uppercase tracking-wider font-mono">The Legacy Way (MealSuite, CBORD, Paper Binders)</div>
          <h3 class="text-xl font-bold text-white">Expensive, Locked-In & Cluttered</h3>
          <ul class="space-y-3 text-sm text-slate-300">
            <li class="flex items-start gap-3"><span class="text-red-400 font-bold">✕</span> $800 to $1,500 monthly fees per building</li>
            <li class="flex items-start gap-3"><span class="text-red-400 font-bold">✕</span> Locked to single distributor pricing (no price comparison)</li>
            <li class="flex items-start gap-3"><span class="text-red-400 font-bold">✕</span> Complicated menus that take weeks to modify</li>
            <li class="flex items-start gap-3"><span class="text-red-400 font-bold">✕</span> Line cooks ignore the app because buttons are too small</li>
            <li class="flex items-start gap-3"><span class="text-red-400 font-bold">✕</span> Scramble to assemble paper binders during annual state survey</li>
          </ul>
        </div>

        <!-- ShorelineOps -->
        <div class="p-8 rounded-3xl bg-blue-950/30 border border-blue-800/60 space-y-4 relative overflow-hidden shadow-xl">
          <div class="text-emerald-400 font-bold text-xs uppercase tracking-wider font-mono">The ShorelineOps Advantage</div>
          <h3 class="text-xl font-bold text-white">Free Software, Chef-Built & Automated</h3>
          <ul class="space-y-3 text-sm text-slate-200">
            <li class="flex items-start gap-3"><span class="text-emerald-400 font-bold">✓</span> <strong>Free Open-Source Software</strong> + $199/mo cloud SaaS</li>
            <li class="flex items-start gap-3"><span class="text-emerald-400 font-bold">✓</span> <strong>Multi-Distributor Split MRP</strong> (Dennis, Sysco, US Foods)</li>
            <li class="flex items-start gap-3"><span class="text-emerald-400 font-bold">✓</span> <strong>Digital Tray Scanner</strong> with live IDDSI & allergen verification</li>
            <li class="flex items-start gap-3"><span class="text-emerald-400 font-bold">✓</span> <strong>1-Click CMS-2567 Federal Survey Binder</strong> (F800–F812 ready)</li>
            <li class="flex items-start gap-3"><span class="text-emerald-400 font-bold">✓</span> <strong>Live PointClickCare EHR Sync</strong> with RD clinical triage</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 KILLER FEATURE BREAKDOWNS -->
  <section id="features" class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-20">
      <div class="text-blue-400 font-bold text-xs uppercase tracking-wider mb-2 font-mono">Complete Enterprise Capabilities</div>
      <h2 class="text-3xl sm:text-5xl font-display font-black text-white tracking-tight mb-4">
        Every Feature Built for Real Kitchen Realities
      </h2>
      <p class="text-slate-400 text-base sm:text-lg">
        Designed for gloved hands, hot ovens, dysphagia safety, and state regulatory inspections.
      </p>
    </div>

    <!-- Feature Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      
      <!-- 1. Multi-Distributor Split MRP -->
      <div class="p-6 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-blue-500/50 transition-all flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-2xl mb-4 text-blue-400">
            🛒
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Multi-Distributor Split MRP</h3>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Upload contract price sheets from <strong>Dennis Food Service, Sysco, and US Foods</strong>. Our bill-of-materials explosion compares line items in real time, automatically routing orders to the lowest-cost vendor.
          </p>
        </div>
        <div class="text-[11px] font-semibold text-emerald-400 bg-emerald-950/40 px-3 py-1.5 rounded-xl border border-emerald-800/40 font-mono">
          💰 Direct Savings: $1.50–$3.00/CPD
        </div>
      </div>

      <!-- 2. Digital Tray Scanner -->
      <div class="p-6 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-amber-500/50 transition-all flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-2xl mb-4 text-amber-400">
            📱
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Digital Tray Card Scanner</h3>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Point any tablet or phone camera at meal trays. OCR barcode scanning verifies resident identity, IDDSI Level 4 Pureed texture compliance, and allergen intersection before trays leave the hot line.
          </p>
        </div>
        <div class="text-[11px] font-semibold text-amber-400 bg-amber-950/40 px-3 py-1.5 rounded-xl border border-amber-800/40 font-mono">
          🛡️ Zero tray delivery errors
        </div>
      </div>

      <!-- 3. PointClickCare EHR Sync -->
      <div class="p-6 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-purple-500/50 transition-all flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-2xl mb-4 text-purple-400">
            🏥
          </div>
          <h3 class="text-lg font-bold text-white mb-2">PointClickCare (PCC) EHR Sync</h3>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Bi-directional integration with PCC and major EHR platforms. Physician diet orders, room moves, and speech pathology swallow assessments automatically sync into the Registered Dietitian Triage Queue.
          </p>
        </div>
        <div class="text-[11px] font-semibold text-purple-400 bg-purple-950/40 px-3 py-1.5 rounded-xl border border-purple-800/40 font-mono">
          ⚡ Automated clinical diet triage
        </div>
      </div>

      <!-- 4. CMS-2567 Survey Binder -->
      <div class="p-6 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-emerald-500/50 transition-all flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-2xl mb-4 text-emerald-400">
            📋
          </div>
          <h3 class="text-lg font-bold text-white mb-2">CMS-2567 Federal Survey Binder</h3>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            When state surveyors walk into the kitchen, generate a complete inspection audit binder in 1 click. Full crosswalk coverage for <strong>Federal F-Tags F800 through F812</strong>, including 14-hour meal timing logs.
          </p>
        </div>
        <div class="text-[11px] font-semibold text-emerald-400 bg-emerald-950/40 px-3 py-1.5 rounded-xl border border-emerald-800/40 font-mono">
          ✓ 100% Survey-Ready compliance
        </div>
      </div>

      <!-- 5. 3-Way Invoice Match & Credit Memos -->
      <div class="p-6 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-teal-500/50 transition-all flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-teal-500/10 border border-teal-500/20 flex items-center justify-center text-2xl mb-4 text-teal-400">
            🧾
          </div>
          <h3 class="text-lg font-bold text-white mb-2">3-Way Invoice Match & Credits</h3>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Scan broadline delivery invoices directly at the loading dock. Automatically flags price overcharges and shorted cases against purchase orders, instantly drafting formal vendor credit memo claims.
          </p>
        </div>
        <div class="text-[11px] font-semibold text-teal-400 bg-teal-950/40 px-3 py-1.5 rounded-xl border border-teal-800/40 font-mono">
          💸 Recover $400–$1,200/mo overcharges
        </div>
      </div>

      <!-- 6. USDA Nutrition Analysis -->
      <div class="p-6 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-rose-500/50 transition-all flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-rose-500/10 border border-rose-500/20 flex items-center justify-center text-2xl mb-4 text-rose-400">
            🥗
          </div>
          <h3 class="text-lg font-bold text-white mb-2">USDA Nutrition & Allergen Solver</h3>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Deep integration with USDA FoodData Central (8,000+ verified ingredients). Automatically calculates calories, protein, and sodium limits for Cardiac, Renal, and Diabetic resident diets.
          </p>
        </div>
        <div class="text-[11px] font-semibold text-rose-400 bg-rose-950/40 px-3 py-1.5 rounded-xl border border-rose-800/40 font-mono">
          🔬 Automated nutrition certification
        </div>
      </div>

    </div>

    <!-- Live Demo CTA Bar -->
    <div class="p-10 rounded-3xl bg-gradient-to-r from-blue-900/40 via-slate-900/60 to-purple-900/40 border border-blue-800/60 text-center max-w-4xl mx-auto shadow-2xl">
      <h3 class="text-2xl sm:text-3xl font-bold text-white mb-3">Experience the Live Operational Sandbox</h3>
      <p class="text-slate-300 text-sm max-w-xl mx-auto mb-6">
        Test our pre-seeded demo facility with 12 residents, IDDSI pureed modifications, Dennis order guides, and digital timecards.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={DEMO_URL} target="_blank" rel="noreferrer" class="px-8 py-3.5 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-xl text-sm transition-all shadow-lg shadow-blue-600/30">
          Launch Interactive Sandbox &rarr;
        </a>
        <a href="/pricing" class="px-8 py-3.5 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold rounded-xl text-sm transition-all border border-slate-700">
          Free Core vs Cloud SaaS Tiers
        </a>
      </div>
    </div>

  </section>
</BaseLayout>

