---
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'
import Logo from '../components/Logo.astro'

const DEMO_URL = import.meta.env.PUBLIC_DEMO_URL || '/demo'
const APP_URL = import.meta.env.PUBLIC_APP_URL || '/app/login'
---

<BaseLayout title="Healthcare Dietary & Clinical Nutrition Platform">
  
  <!-- ════════════════════════════════════════════════════════════════════════════
       1. SIGNATURE OPENING: ARCHITECTURAL ASYMMETRIC SPLIT
       ════════════════════════════════════════════════════════════════════════════ -->
  <section class="marketing-page-intro relative pt-8 sm:pt-14 pb-14 sm:pb-20 border-b border-slate-200/80 dark:border-obsidian-border overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- Left 7 Cols: Authoritative Editorial Thesis -->
        <div class="lg:col-span-7 space-y-6 text-left">
          
          <!-- Provenance Micro-Label -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-shoreline-50 dark:bg-shoreline-950/80 border border-shoreline-200/80 dark:border-shoreline-800/80 text-shoreline-800 dark:text-shoreline-300 text-[11px] font-bold font-mono tracking-wider uppercase">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>CLINICAL NUTRITION &amp; KITCHEN OS · BUILT BY AN EXECUTIVE CHEF</span>
          </div>

          <!-- Main Typographic Headline -->
          <h1 class="font-display text-3xl sm:text-5xl lg:text-[3.5rem] font-extrabold text-slate-900 dark:text-white tracking-[-0.03em] leading-[1.08]">
            The Operating System for Clinical Nutrition and Institutional Kitchens.
          </h1>

          <!-- Direct, Grounded Thesis -->
          <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl font-normal leading-relaxed">
            Eliminate dysphagia choking hazards with non-overridable IDDSI 2.0 locks, log tamper-evident HACCP temperatures on gloved kitchen tablets, and stop single-source food distributor markups with split-contract price routing.
          </p>

          <!-- Primary Interaction Group -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-1">
            <a
              href={DEMO_URL}
              class="px-6 py-3.5 bg-slate-900 hover:bg-slate-800 dark:bg-shoreline-600 dark:hover:bg-shoreline-500 text-white font-bold rounded-lg text-xs sm:text-sm transition-all shadow-md inline-flex items-center justify-center gap-2 active:scale-[0.98]"
            >
              <span>Launch Interactive Sandbox</span>
              <Icon name="arrow-right" class="w-4 h-4" />
            </a>

            <a
              href="https://github.com/ShadowWalkerNC/ShorelineOps"
              target="_blank"
              rel="noreferrer"
              class="px-5 py-3.5 bg-white dark:bg-obsidian-surface hover:bg-slate-50 dark:hover:bg-slate-800/80 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-obsidian-border font-semibold rounded-lg text-xs sm:text-sm transition-all inline-flex items-center justify-center gap-2 shadow-2xs active:scale-[0.98]"
            >
              <Icon name="github" class="w-4 h-4" />
              <span>Free GitHub Core</span>
            </a>

            <a
              href="/pricing"
              class="px-4 py-3.5 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white text-xs sm:text-sm font-semibold transition-colors inline-flex items-center justify-center gap-1.5"
            >
              <span>SaaS Pricing</span>
              <Icon name="chevron-right" class="w-3.5 h-3.5" />
            </a>
          </div>

          <!-- Verified Telemetry Capabilities -->
          <div class="pt-4 border-t border-slate-200/80 dark:border-obsidian-border grid grid-cols-3 gap-3 text-[11px] font-mono text-slate-500 dark:text-slate-400">
            <div>
              <span class="block text-slate-900 dark:text-white font-bold text-xs">100% Offline Core</span>
              <span>Local SQLite Engine</span>
            </div>
            <div>
              <span class="block text-slate-900 dark:text-white font-bold text-xs">IDDSI 2.0 Hard-Blocks</span>
              <span>Non-Overridable Safety</span>
            </div>
            <div>
              <span class="block text-slate-900 dark:text-white font-bold text-xs">Multi-Distributor</span>
              <span>Dennis &amp; Sysco Split MRP</span>
            </div>
          </div>

        </div>

        <!-- Right 5 Cols: Signature Live Clinical Line Telemetry Console -->
        <div class="lg:col-span-5">
          <div class="rounded-xl border border-slate-300 dark:border-obsidian-border bg-white dark:bg-obsidian-surface shadow-elevated overflow-hidden font-sans">
            
            <!-- Terminal Header Bar -->
            <div class="px-4 py-3 bg-slate-50 dark:bg-obsidian border-b border-slate-200 dark:border-obsidian-border flex items-center justify-between text-xs font-mono">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="font-bold text-slate-800 dark:text-slate-200">TRAY LINE TELEMETRY</span>
              </div>
              <span class="text-[10px] text-slate-400">STATION #2 · ACTIVE</span>
            </div>

            <!-- Console Body: Resident Ticket with IDDSI Invariant -->
            <div class="p-5 space-y-4">
              
              <!-- Resident Identity -->
              <div class="flex items-start justify-between pb-3 border-b border-slate-100 dark:border-slate-800/80">
                <div>
                  <div class="text-xs font-mono text-slate-400">RESIDENT PROFILE</div>
                  <div class="font-display font-bold text-base text-slate-900 dark:text-white">Harold Simmons</div>
                  <div class="text-xs text-slate-500">Room 204-B · Pines Wing · Table 4</div>
                </div>
                <span class="px-2 py-1 rounded bg-slate-100 dark:bg-slate-800 font-mono text-[11px] font-bold text-slate-700 dark:text-slate-300">
                  CENSUS #892
                </span>
              </div>

              <!-- Strict IDDSI Dysphagia Chips -->
              <div class="space-y-1.5">
                <div class="text-[10px] font-mono uppercase tracking-wider text-slate-400">Required Texture &amp; Consistency</div>
                <div class="flex flex-wrap gap-2">
                  <span class="px-2.5 py-1 rounded bg-amber-500/15 border border-amber-500/40 text-amber-800 dark:text-amber-300 text-xs font-bold font-mono inline-flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                    IDDSI LEVEL 4 · PURÉED
                  </span>
                  <span class="px-2.5 py-1 rounded bg-blue-500/15 border border-blue-500/40 text-blue-800 dark:text-blue-300 text-xs font-bold font-mono">
                    LEVEL 2 · MILDLY THICK (NECTAR)
                  </span>
                </div>
              </div>

              <!-- Allergen Hard-Block Alert -->
              <div class="p-3 rounded-lg bg-rose-50 dark:bg-rose-950/40 border border-rose-300 dark:border-rose-900/60 text-xs">
                <div class="flex items-center gap-1.5 text-rose-800 dark:text-rose-300 font-bold font-mono text-[11px] uppercase tracking-wider">
                  <Icon name="shield-alert" class="w-3.5 h-3.5 text-rose-600" />
                  <span>Safety Interlock: Active Allergen Exclusion</span>
                </div>
                <div class="text-rose-700 dark:text-rose-200 mt-1 font-medium">
                  SHELLFISH &bull; PEANUTS &bull; NPO AFTER 22:00
                </div>
              </div>

              <!-- Kitchen Steam Table HACCP Telemetry -->
              <div class="p-3 rounded-lg bg-slate-50 dark:bg-obsidian border border-slate-200/80 dark:border-obsidian-border flex items-center justify-between text-xs">
                <div>
                  <div class="text-[10px] font-mono text-slate-400">STEAM TABLE #3 TEMPERATURE</div>
                  <div class="font-bold text-slate-900 dark:text-white flex items-center gap-1.5 mt-0.5">
                    <span class="text-emerald-600 dark:text-emerald-400 font-mono text-sm">172.4°F</span>
                    <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-mono font-semibold">(HACCP SAFE &gt; 165°F)</span>
                  </div>
                </div>
                <div class="text-right font-mono text-[10px] text-slate-400">
                  <div>AUTO-LOGGED</div>
                  <div class="text-slate-500">11:42:09 EST</div>
                </div>
              </div>

              <!-- Dennis vs Sysco Split Price Match Line -->
              <div class="pt-2 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs font-mono">
                <div class="flex items-center gap-1.5">
                  <span class="text-emerald-600 font-bold">Dennis #DNS-01</span>
                  <span class="text-slate-400">($2.15/lb)</span>
                </div>
                <span class="text-emerald-600 dark:text-emerald-400 font-bold bg-emerald-50 dark:bg-emerald-950/80 px-2 py-0.5 rounded text-[10px]">
                  SAVES 18.6% VS SYSCO
                </span>
              </div>

            </div>

          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════════════
       2. THE TWO REALITIES: ARCHITECTURAL CONTRAST GRID (NO FLOATING CARDS)
       ════════════════════════════════════════════════════════════════════════════ -->
  <section class="py-16 sm:py-20 border-b border-slate-200/80 dark:border-obsidian-border bg-slate-50/50 dark:bg-obsidian-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-12 text-left">
        <div class="text-shoreline-700 dark:text-shoreline-400 font-bold text-xs uppercase tracking-wider font-mono mb-2">The Operating Difference</div>
        <h2 class="font-display text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-[-0.02em]">
          Institutional Kitchens Are Replacing Legacy Monopolies with Shoreline.
        </h2>
      </div>

      <!-- Architectural Grid Split with Shared Hairline Border -->
      <div class="grid grid-cols-1 md:grid-cols-2 border border-slate-200 dark:border-obsidian-border rounded-xl overflow-hidden bg-white dark:bg-obsidian-surface shadow-subtle">
        
        <!-- Legacy Monopolies & Clipboards Column -->
        <div class="p-6 sm:p-10 border-b md:border-b-0 md:border-r border-slate-200 dark:border-obsidian-border space-y-6">
          <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
            <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-rose-600 dark:text-rose-400">Legacy Corporate Software</span>
            <span class="text-xs font-mono text-slate-400">$10,000–$18,000/yr Tax</span>
          </div>

          <h3 class="font-display text-xl font-bold text-slate-900 dark:text-white">
            Monopolistic Lock-In &amp; Daily Paper Risk
          </h3>

          <ul class="space-y-4 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
            <li class="flex items-start gap-3">
              <span class="text-rose-500 font-bold text-base leading-none">&times;</span>
              <span><strong>Single-Vendor Monopsony:</strong> Ordering from one food distributor with zero price competition or item-level auditing.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-rose-500 font-bold text-base leading-none">&times;</span>
              <span><strong>Grease-Stained Dry Erase Boards:</strong> New pureed or minced orders missed during the 11:30 AM tray line rush.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-rose-500 font-bold text-base leading-none">&times;</span>
              <span><strong>Choking Liability:</strong> Inadvertent serving of mechanical soft bread to pureed residents without digital safety interlocks.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-rose-500 font-bold text-base leading-none">&times;</span>
              <span><strong>Survey Panic:</strong> Scrambling to reconstruct 90 days of food temperatures when state CMS inspectors arrive unannounced.</span>
            </li>
          </ul>
        </div>

        <!-- The Shoreline Care OS Way Column -->
        <div class="p-6 sm:p-10 space-y-6 bg-slate-50/40 dark:bg-obsidian/40">
          <div class="flex items-center justify-between pb-3 border-b border-slate-200/80 dark:border-slate-800">
            <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-shoreline-700 dark:text-shoreline-400">Shoreline Care OS</span>
            <span class="text-xs font-mono text-emerald-600 dark:text-emerald-400 font-bold">100% Free Core or Managed SaaS</span>
          </div>

          <h3 class="font-display text-xl font-bold text-slate-900 dark:text-white">
            Deterministic Safety &amp; Open Culinary Economics
          </h3>

          <ul class="space-y-4 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
            <li class="flex items-start gap-3">
              <span class="text-emerald-500 font-bold text-base leading-none">&check;</span>
              <span><strong>Multi-Distributor Split MRP:</strong> Compares Dennis, Sysco, and US Foods contracts line-by-line, routing to the lowest $/lb price.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-500 font-bold text-base leading-none">&check;</span>
              <span><strong>IDDSI 2.0 Hard-Blocks:</strong> Prevents kitchen staff from generating tray cards for texture-mismatched or allergen-flagged meals.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-500 font-bold text-base leading-none">&check;</span>
              <span><strong>Gloved Touch Kiosk (48px+):</strong> High-contrast buttons designed for line cooks tapping with wet, gloved hands.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-500 font-bold text-base leading-none">&check;</span>
              <span><strong>1-Click CMS-2567 Binder:</strong> Complete HACCP log export with verifiable corrective actions ready in under 10 seconds.</span>
            </li>
          </ul>
        </div>

      </div>

    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════════════
       3. SIGNATURE MOMENT 2: SPLIT MRP VENDOR PRICE MATRIX
       ════════════════════════════════════════════════════════════════════════════ -->
  <section id="split-mrp" class="marketing-comparison py-16 sm:py-20 border-b border-slate-200/80 dark:border-obsidian-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <div class="lg:col-span-5 space-y-4 text-left">
          <div class="text-shoreline-700 dark:text-shoreline-400 font-bold text-xs uppercase tracking-wider font-mono">Procurement Economics</div>
          <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-[-0.02em]">
            Break Distributor Pack Obfuscation. Cut Food Spend by 8–18%.
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            Distributors intentionally disguise pack sizes (<code class="font-mono text-slate-800 dark:text-slate-200 bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded text-[11px]">40/4oz</code> vs <code class="font-mono text-slate-800 dark:text-slate-200 bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded text-[11px]">2/10 lb</code>) to prevent direct price comparison. Shoreline’s pack normalizer converts every offer to canonical <span class="font-bold text-emerald-600 dark:text-emerald-400">$/lb</span> and <span class="font-bold text-emerald-600 dark:text-emerald-400">$/fl oz</span> metrics.
          </p>
          <div class="pt-2">
            <a
              href="/distributors"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-shoreline-700 dark:text-shoreline-400 hover:underline"
            >
              <span>Explore Distributor Partner Portal</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>

        <div class="lg:col-span-7">
          <!-- Live Interactive Mock Price Spread Console -->
          <div class="rounded-xl border border-slate-200 dark:border-obsidian-border bg-white dark:bg-obsidian-surface shadow-surface overflow-hidden">
            <div class="px-4 py-3 bg-slate-50 dark:bg-obsidian border-b border-slate-200 dark:border-obsidian-border flex items-center justify-between text-xs font-mono">
              <span class="font-bold text-slate-700 dark:text-slate-300">SPLIT MRP COMPARATOR</span>
              <span class="text-emerald-600 dark:text-emerald-400 font-bold">AUTOMATIC ROUTING ACTIVE</span>
            </div>

            <div class="divide-y divide-slate-100 dark:divide-slate-800/80 text-xs">
              
              <!-- Row 1 -->
              <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div>
                  <div class="font-display font-bold text-slate-900 dark:text-white text-sm">Boneless Skinless Chicken Breast (Fresh)</div>
                  <div class="text-[11px] text-slate-500 font-mono mt-0.5">Dennis #DNS-01 ($2.15/lb) vs. Sysco #SY-1092 ($2.55/lb)</div>
                </div>
                <div class="sm:text-right shrink-0">
                  <span class="inline-block px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-800 dark:text-emerald-300 font-mono font-bold text-xs">
                    Dennis Wins (-18.6%)
                  </span>
                  <div class="text-[10px] text-slate-400 font-mono mt-0.5">Routes to Dennis PO</div>
                </div>
              </div>

              <!-- Row 2 -->
              <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div>
                  <div class="font-display font-bold text-slate-900 dark:text-white text-sm">Ground Beef 80/20 Fresh (Coarse Ground)</div>
                  <div class="text-[11px] text-slate-500 font-mono mt-0.5">Dennis #DNS-02 ($3.89/lb) vs. Sysco #SY-2093 ($4.20/lb)</div>
                </div>
                <div class="sm:text-right shrink-0">
                  <span class="inline-block px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-800 dark:text-emerald-300 font-mono font-bold text-xs">
                    Dennis Wins (-8.0%)
                  </span>
                  <div class="text-[10px] text-slate-400 font-mono mt-0.5">Routes to Dennis PO</div>
                </div>
              </div>

              <!-- Row 3 -->
              <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div>
                  <div class="font-display font-bold text-slate-900 dark:text-white text-sm">Idaho Russet Potatoes #1 (50 lb Carton)</div>
                  <div class="text-[11px] text-slate-500 font-mono mt-0.5">Sysco #SY-4019 ($0.52/lb) vs. Dennis #DNS-04 ($0.59/lb)</div>
                </div>
                <div class="sm:text-right shrink-0">
                  <span class="inline-block px-2 py-0.5 rounded bg-shoreline-500/15 text-shoreline-800 dark:text-shoreline-300 font-mono font-bold text-xs">
                    Sysco Wins (-11.5%)
                  </span>
                  <div class="text-[10px] text-slate-400 font-mono mt-0.5">Routes to Sysco PO</div>
                </div>
              </div>

            </div>

            <div class="p-4 bg-slate-50 dark:bg-obsidian border-t border-slate-200 dark:border-obsidian-border flex items-center justify-between text-xs font-mono">
              <span class="text-slate-600 dark:text-slate-400">Net Estimated Monthly Variance:</span>
              <span class="font-bold text-emerald-600 dark:text-emerald-400 text-sm">+$428.50 / Month Captured</span>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════════════
       4. FOUR CORE OPERATIONAL WORKBENCHES (ARCHITECTURAL GRID, NOT CARDS)
       ════════════════════════════════════════════════════════════════════════════ -->
  <section id="features" class="marketing-workbenches py-16 sm:py-24 border-b border-slate-200/80 dark:border-obsidian-border bg-slate-50/30 dark:bg-obsidian-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-14 text-left">
        <div class="text-shoreline-700 dark:text-shoreline-400 font-bold text-xs uppercase tracking-wider font-mono mb-2">Operational Subsystems</div>
        <h2 class="font-display text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-[-0.02em]">
          Four Unified Stations. Zero Clutter.
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1 max-w-xl">
          Designed specifically for the ergonomics of nursing homes, memory care facilities, and senior living dining rooms.
        </p>
      </div>

      <!-- Architectural 2x2 Workbench with continuous gridlines -->
      <div class="grid grid-cols-1 md:grid-cols-2 border border-slate-200 dark:border-obsidian-border rounded-xl overflow-hidden bg-white dark:bg-obsidian-surface shadow-subtle">
        
        <!-- Workbench 01 -->
        <div class="p-6 sm:p-8 border-b md:border-r border-slate-200 dark:border-obsidian-border space-y-4">
          <div class="text-xs font-mono font-bold text-slate-400">01 / CENSUS &amp; IDDSI SAFETY</div>
          <h3 class="font-display text-lg font-bold text-slate-900 dark:text-white">Resident Diets &amp; Clinical Order Triage</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Maintain active therapeutic diet orders (diabetic, low-sodium, renal, pureed, minced &amp; moist) with zero lag. Connect directly to PointClickCare EHR or import via CSV.
          </p>
          <div class="rounded-lg overflow-hidden border border-slate-200 dark:border-slate-800">
            <img src="/screenshots/residents_iddsi_triage.png" alt="Clinical Census" class="w-full h-auto object-cover" />
          </div>
        </div>

        <!-- Workbench 02 -->
        <div class="p-6 sm:p-8 border-b border-slate-200 dark:border-obsidian-border space-y-4">
          <div class="text-xs font-mono font-bold text-slate-400">02 / CULINARY PRODUCTION</div>
          <h3 class="font-display text-lg font-bold text-slate-900 dark:text-white">4-Week Cycle Menu &amp; Recipe Scaler</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Plan breakfast, lunch, and dinner cycles with daily alternates. Scale yields instantly for changing daily resident census counts with automated USDA nutritional verification.
          </p>
          <div class="rounded-lg overflow-hidden border border-slate-200 dark:border-slate-800">
            <img src="/screenshots/menu_cycle_planner.png" alt="Cycle Menu Planner" class="w-full h-auto object-cover" />
          </div>
        </div>

        <!-- Workbench 03 -->
        <div class="p-6 sm:p-8 md:border-r border-slate-200 dark:border-obsidian-border space-y-4">
          <div class="text-xs font-mono font-bold text-slate-400">03 / LINE KIOSK &amp; HACCP</div>
          <h3 class="font-display text-lg font-bold text-slate-900 dark:text-white">Touch Tablet for Gloved Line Cooks</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Large 48px+ touch targets built for kitchen speed. Cooks tap to view meal tallies, record genuine steam table temps, and print thermal tray cards directly at the line.
          </p>
          <div class="rounded-lg overflow-hidden border border-slate-200 dark:border-slate-800">
            <img src="/screenshots/kitchen_tablet_kiosk.png" alt="Kitchen Kiosk" class="w-full h-auto object-cover" />
          </div>
        </div>

        <!-- Workbench 04 -->
        <div class="p-6 sm:p-8 space-y-4">
          <div class="text-xs font-mono font-bold text-slate-400">04 / PROCUREMENT &amp; SPLIT MRP</div>
