---
interface Props {
  title: string
  description?: string
}

const { title, description = 'The open-source dietary operations and care coordination platform for senior living facilities. Free core software with managed enterprise SaaS.' } = Astro.props
const DEMO_URL = import.meta.env.PUBLIC_DEMO_URL || 'https://shoreline-demo.onrender.com'
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — ShorelineOps</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-slate-950 text-slate-100 font-sans antialiased selection:bg-blue-500 selection:text-white flex flex-col min-h-screen">
    <!-- Apple HIG Frosted Glass Navigation -->
    <header class="sticky top-0 z-50 border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-2xl">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div className="w-9 h-9 rounded-xl bg-blue-600 flex items-center justify-center font-display font-black text-xl text-white shadow-md shadow-blue-500/25 group-hover:scale-105 transition-transform">
            S
          </div>
          <div>
            <span class="font-display font-bold text-lg text-white tracking-tight">ShorelineOps</span>
            <span class="hidden sm:inline-block ml-2 text-[10px] font-bold uppercase tracking-wider text-blue-400 bg-blue-950/80 px-2 py-0.5 rounded-full border border-blue-800/60 font-mono">Care OS v5.0</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
          <a href="/#features" class="hover:text-white transition-colors">Features</a>
          <a href="/pricing" class="hover:text-white transition-colors">Pricing & Free Core</a>
          <a href="/distributors" class="hover:text-white transition-colors">Distributors (Dennis & Sysco)</a>
          <a href="/story" class="hover:text-white transition-colors">Chef's Story</a>
        </nav>

        <div class="flex items-center gap-3">
          <a href="https://github.com/ShadowWalkerNC/ShorelineOps" target="_blank" rel="noreferrer" class="text-xs font-semibold px-3 py-1.5 rounded-xl border border-slate-800 bg-slate-900/60 text-slate-300 hover:text-white hover:border-slate-700 transition-all hidden sm:flex items-center gap-1.5">
            <span>⭐ GitHub</span>
          </a>
          <a href={DEMO_URL} target="_blank" rel="noreferrer" class="inline-flex items-center justify-center px-4 py-2 text-xs font-bold text-white bg-blue-600 hover:bg-blue-500 rounded-xl transition-all shadow-md shadow-blue-600/30 hover:scale-[1.02] active:scale-[0.98]">
            Launch Live Demo &rarr;
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800/80 bg-slate-950/90 py-16 text-slate-400 text-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <div class="w-6 h-6 rounded-lg bg-blue-600 flex items-center justify-center font-bold text-white text-xs">S</div>
            <div class="font-display font-bold text-lg text-white">ShorelineOps</div>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            The open-source clinical nutrition & dietary operations platform built by an executive healthcare chef. Free community core software with managed enterprise SaaS.
          </p>
          <div class="text-xs text-slate-500 font-mono">Built in Maine 🌲 · Zero Lock-In</div>
        </div>

        <div>
          <div class="font-bold text-white text-xs uppercase tracking-wider mb-3 font-mono">Features</div>
          <ul class="space-y-2 text-xs">
            <li><a href="/#features" class="hover:text-white">Multi-Distributor Split MRP</a></li>
            <li><a href="/#features" class="hover:text-white">Digital Tray Card Scanner</a></li>
            <li><a href="/#features" class="hover:text-white">PointClickCare EHR Sync</a></li>
            <li><a href="/#features" class="hover:text-white">CMS-2567 Federal Survey Binder</a></li>
            <li><a href="/#features" class="hover:text-white">IDDSI Dysphagia Hard-Blocks</a></li>
          </ul>
        </div>

        <div>
          <div class="font-bold text-white text-xs uppercase tracking-wider mb-3 font-mono">Platform & SaaS</div>
          <ul class="space-y-2 text-xs">
            <li><a href="/pricing" class="hover:text-white">Free Core vs Managed SaaS</a></li>
            <li><a href="/distributors" class="hover:text-white">Dennis & Sysco Partner Portal</a></li>
            <li><a href={DEMO_URL} class="hover:text-white">Interactive Demo Web App</a></li>
            <li><a href="https://github.com/ShadowWalkerNC/ShorelineOps" class="hover:text-white">Self-Hosted Docker Stack</a></li>
          </ul>
        </div>

        <div>
          <div class="font-bold text-white text-xs uppercase tracking-wider mb-3 font-mono">Compliance & Legal</div>
          <ul class="space-y-2 text-xs">
            <li><a href="https://github.com/ShadowWalkerNC/ShorelineOps/blob/main/COMMERCIAL_AGREEMENT.md" class="hover:text-white">Master Services Agreement (MSA)</a></li>
            <li><a href="https://github.com/ShadowWalkerNC/ShorelineOps/blob/main/BAA.md" class="hover:text-white">Business Associate Agreement (BAA)</a></li>
            <li><a href="https://github.com/ShadowWalkerNC/ShorelineOps/blob/main/HIPAA_NOTICE.md" class="hover:text-white">HIPAA Notice of Privacy Practices</a></li>
            <li><a href="https://github.com/ShadowWalkerNC/ShorelineOps/blob/main/LICENSE" class="hover:text-white">MIT Open-Source License</a></li>
          </ul>
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-slate-800/60 pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500">
        <div>© 2026 Shoreline Operations LLC. Free Open Source Core under MIT License.</div>
        <div class="mt-2 sm:mt-0 font-mono text-[11px]">Free Software · Enterprise Cloud SaaS</div>
      </div>
    </footer>
  </body>
</html>

