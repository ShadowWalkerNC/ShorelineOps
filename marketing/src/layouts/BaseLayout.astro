---
interface Props {
  title: string
  description?: string
  canonicalPath?: string
  ogImage?: string
  keywords?: string
}

import Icon from '../components/Icon.astro'
import '../styles/global.css'

const { 
  title, 
  description = 'Open-source kitchen operations and resident diet safety software for senior living, assisted living, and care dining.',
  canonicalPath = '',
  ogImage = '/logo.png',
  keywords = 'healthcare dietary operations, senior living clinical nutrition, resident diet safety, dysphagia textures, food service, cycle menu planner, kitchen temperature log'
} = Astro.props

const DEMO_URL = import.meta.env.PUBLIC_DEMO_URL || '/demo'
const APP_URL = import.meta.env.PUBLIC_APP_URL || '/app/login'
const SITE_URL = 'https://shorelineops.com'
const canonicalURL = new URL(canonicalPath || Astro.url.pathname, SITE_URL).toString()
const fullOgImageUrl = new URL(ogImage, SITE_URL).toString()

const schemaJson = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    'name': 'Shoreline Care OS',
    'operatingSystem': 'Web, iOS, Android, macOS, Windows, Linux',
    'applicationCategory': 'HealthApplication, BusinessApplication',
    'description': description,
    'offers': {
      '@type': 'AggregateOffer',
      'priceCurrency': 'USD',
      'lowPrice': '0',
      'highPrice': '399',
      'offerCount': '3'
    },
    'featureList': [
      'Resident Diet & Allergy Safety Alerts',
      '4-Week Seasonal Cycle Menu Planning',
      'Scaled Recipe Yields & Cook Sheets',
      'Food Distributor Price Comparison',
      'Kitchen Touch Tablet for Cooks',
      'Food Safety & Temperature Logs'
    ],
    'creator': {
      '@type': 'Organization',
      'name': 'Shoreline Operations LLC',
      'url': 'https://shorelineops.com'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalBusiness',
    'name': 'Shoreline Operations LLC',
    'url': 'https://shorelineops.com',
    'logo': 'https://shorelineops.com/logo.png',
    'description': 'Healthcare clinical nutrition technology and institutional dietary operations software for senior living, assisted living, and skilled nursing facilities.',
    'address': {
      '@type': 'PostalAddress',
      'addressLocality': 'Portland',
      'addressRegion': 'ME',
      'postalCode': '04101',
      'addressCountry': 'US'
    },
    'geo': {
      '@type': 'GeoCoordinates',
      'latitude': '43.6591',
      'longitude': '-70.2568'
    }
  }
])
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — ShorelineOps Care OS</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Geolocation Meta Tags (Maine Coastal Senior Living Origin) -->
    <meta name="geo.region" content="US-ME" />
    <meta name="geo.placename" content="Portland, Maine" />
    <meta name="geo.position" content="43.6591;-70.2568" />
    <meta name="ICBM" content="43.6591, -70.2568" />

    <!-- OpenGraph Social Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ShorelineOps Care OS" />
    <meta property="og:title" content={`${title} — ShorelineOps Care OS`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={fullOgImageUrl} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ShorelineOps" />
    <meta name="twitter:creator" content="@ShorelineOps" />
    <meta name="twitter:title" content={`${title} — ShorelineOps Care OS`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImageUrl} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={schemaJson} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#fbfbfc] dark:bg-obsidian text-slate-900 dark:text-slate-100 font-sans antialiased selection:bg-shoreline-500 selection:text-white flex flex-col min-h-screen">
    <!-- Precision Architectural Header Navigation -->
    <header class="sticky top-0 z-50 border-b border-slate-200/80 dark:border-obsidian-border bg-white/95 dark:bg-obsidian/95 backdrop-blur-xl transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 sm:h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <img
            src="/brand/shorelineops-icon.svg"
            alt="Shoreline Care OS"
            class="h-8 sm:h-9 w-auto object-contain group-hover:scale-105 transition-transform"
          />
          <div class="flex items-center gap-2">
            <span class="font-display font-extrabold text-sm sm:text-base tracking-tight text-slate-900 dark:text-white">Shoreline<span class="text-shoreline-600 dark:text-shoreline-400">Ops</span></span>
            <span class="hidden sm:inline-flex items-center gap-1.5 text-[9px] font-bold uppercase tracking-wider text-shoreline-700 dark:text-shoreline-300 bg-shoreline-50 dark:bg-shoreline-950 px-2 py-0.5 rounded-md border border-shoreline-200/70 dark:border-shoreline-800/60 font-mono">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              CARE OS v5.0
            </span>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-7 text-xs font-semibold text-slate-600 dark:text-slate-300">
          <a href="/#features" class="hover:text-shoreline-600 dark:hover:text-white transition-colors">Platform Features</a>
          <a href="/#split-mrp" class="hover:text-shoreline-600 dark:hover:text-white transition-colors">Split MRP</a>
          <a href="/#clinical-safety" class="hover:text-shoreline-600 dark:hover:text-white transition-colors">Clinical IDDSI</a>
          <a href="/pricing" class="hover:text-shoreline-600 dark:hover:text-white transition-colors">Pricing &amp; Open Core</a>
          <a href="/distributors" class="hover:text-shoreline-600 dark:hover:text-white transition-colors">Distributors</a>
        </nav>

        <div class="flex items-center gap-2 sm:gap-3">
          <a
            href="https://github.com/ShadowWalkerNC/ShorelineOps"
            target="_blank"
            rel="noreferrer"
            class="text-xs font-semibold px-3 py-1.5 rounded-lg border border-slate-200 dark:border-obsidian-border bg-slate-50 dark:bg-obsidian-surface text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-slate-700 transition-all hidden sm:flex items-center gap-1.5 shadow-2xs active:scale-[0.98]"
          >
            <Icon name="github" class="w-3.5 h-3.5 text-slate-700 dark:text-slate-300" />
            <span>GitHub</span>
          </a>
          <a
            href={APP_URL}
            class="text-xs font-semibold px-3 py-1.5 sm:py-2 rounded-lg border border-slate-200 dark:border-obsidian-border bg-white dark:bg-obsidian-surface text-slate-700 dark:text-slate-200 hover:text-slate-900 dark:hover:text-white transition-all inline-flex items-center gap-1.5 shadow-2xs active:scale-[0.98]"
          >
            <span>Staff Portal</span>
          </a>
          <a
            href={DEMO_URL}
            class="inline-flex items-center justify-center px-3.5 sm:px-4 py-1.5 sm:py-2 text-xs font-bold text-white bg-slate-900 hover:bg-slate-800 dark:bg-shoreline-600 dark:hover:bg-shoreline-500 rounded-lg transition-all shadow-sm hover:shadow-md active:scale-[0.98] gap-1.5"
          >
            <span>Live Sandbox</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <!-- Apple HIG Clean Footer -->
    <footer class="border-t border-slate-200/80 dark:border-slate-800/80 bg-white/60 dark:bg-slate-950/80 py-12 text-slate-500 dark:text-slate-400 text-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 mb-10">
        <div>
          <div class="flex items-center gap-2 mb-2.5">
            <img src="/brand/shorelineops-icon.svg" alt="ShorelineOps" class="w-6 h-6 rounded-lg object-contain" />
            <div class="font-bold text-sm text-slate-900 dark:text-white">ShorelineOps</div>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed mb-3">
            The open-source clinical nutrition & dietary operations platform built by an executive healthcare chef. Free community core software with managed enterprise SaaS.
          </p>
          <div class="text-[11px] text-slate-400 font-mono">Portland, ME · Healthcare Dietary Operations · Zero Vendor Lock-In</div>
        </div>

        <div>
          <div class="font-bold text-slate-900 dark:text-white text-[11px] uppercase tracking-wider mb-2.5 font-mono">Features</div>
          <ul class="space-y-1.5 text-xs">
            <li><a href="/#features" class="hover:text-blue-600 dark:hover:text-white transition-colors">Multi-Distributor Split MRP</a></li>
            <li><a href="/#features" class="hover:text-blue-600 dark:hover:text-white transition-colors">Digital Tray Card Scanner</a></li>
            <li><a href="/#features" class="hover:text-blue-600 dark:hover:text-white transition-colors">PointClickCare EHR Sync</a></li>
            <li><a href="/#features" class="hover:text-blue-600 dark:hover:text-white transition-colors">CMS-2567 Federal Survey Binder</a></li>
            <li><a href="/#features" class="hover:text-blue-600 dark:hover:text-white transition-colors">IDDSI Dysphagia Hard-Blocks</a></li>
          </ul>
        </div>

        <div>
          <div class="font-bold text-slate-900 dark:text-white text-[11px] uppercase tracking-wider mb-2.5 font-mono">Platform & SaaS</div>
          <ul class="space-y-1.5 text-xs">
            <li><a href="/pricing" class="hover:text-blue-600 dark:hover:text-white transition-colors">Free Core vs Managed SaaS</a></li>
            <li><a href={APP_URL} class="hover:text-blue-600 dark:hover:text-white transition-colors">SaaS Staff Portal Login</a></li>
            <li><a href="/distributors" class="hover:text-blue-600 dark:hover:text-white transition-colors">Dennis &amp; Sysco Partner Portal</a></li>
            <li><a href={DEMO_URL} class="hover:text-blue-600 dark:hover:text-white transition-colors">Interactive Demo Sandbox</a></li>
            <li><a href="https://github.com/ShadowWalkerNC/ShorelineOps" class="hover:text-blue-600 dark:hover:text-white transition-colors">Free Community Edition (GitHub)</a></li>
          </ul>
        </div>

        <div>
          <div class="font-bold text-slate-900 dark:text-white text-[11px] uppercase tracking-wider mb-2.5 font-mono">Compliance & Legal</div>
          <ul class="space-y-1.5 text-xs">
            <li><a href="/terms" class="hover:text-blue-600 dark:hover:text-white transition-colors">Terms of Service & MSA</a></li>
            <li><a href="/privacy" class="hover:text-blue-600 dark:hover:text-white transition-colors">Healthcare Privacy & HIPAA BAA</a></li>
            <li><a href="/security" class="hover:text-blue-600 dark:hover:text-white transition-colors">Security Architecture & SLA</a></li>
            <li><a href="https://github.com/ShadowWalkerNC/ShorelineOps/blob/main/LICENSING.md" class="hover:text-blue-600 dark:hover:text-white transition-colors">Open Core License Architecture</a></li>
          </ul>
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-slate-200/80 dark:border-slate-800/60 pt-5 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400">
        <div>© 2026 Shoreline Operations LLC. Free Open Source Core under AGPL/MIT License.</div>
        <div class="mt-2 sm:mt-0 font-mono text-[11px]">Free Core Software · Enterprise Cloud SaaS · Maine Healthcare Tech</div>
      </div>
    </footer>
  </body>
</html>
