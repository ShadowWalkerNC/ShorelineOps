---
interface Props {
  title: string
  description?: string
  canonicalPath?: string
  ogImage?: string
  keywords?: string
}

import Icon from '../components/Icon.astro'

const { 
  title, 
  description = 'Open-source kitchen operations and resident diet safety software for senior living, assisted living, and care dining.',
  canonicalPath = '',
  ogImage = '/logo.png',
  keywords = 'healthcare dietary operations, senior living clinical nutrition, resident diet safety, dysphagia textures, food service, cycle menu planner, kitchen temperature log'
} = Astro.props

const DEMO_URL = import.meta.env.PUBLIC_DEMO_URL || '/demo'
const SITE_URL = 'https://shorelineops.com'
const canonicalURL = canonicalPath ? new URL(canonicalPath, SITE_URL).toString() : Astro.url.href
const fullOgImageUrl = new URL(ogImage, SITE_URL).toString()

const schemaJson = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    'name': 'Shoreline Care OS',
    'operatingSystem': 'Web, iOS, Android, macOS, Windows, Linux',
    'applicationCategory': 'HealthApplication, BusinessApplication',
    'description': description,
    'offers': {
      '@type': 'AggregateOffer',
      'priceCurrency': 'USD',
      'lowPrice': '0',
      'highPrice': '399',
      'offerCount': '3'
    },
    'featureList': [
      'Resident Diet & Allergy Safety Alerts',
      '4-Week Seasonal Cycle Menu Planning',
      'Scaled Recipe Yields & Cook Sheets',
      'Food Distributor Price Comparison',
      'Kitchen Touch Tablet for Cooks',
      'Food Safety & Temperature Logs'
    ],
    'creator': {
      '@type': 'Organization',
      'name': 'Shoreline Operations LLC',
      'url': 'https://shorelineops.com'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalBusiness',
    'name': 'Shoreline Operations LLC',
    'url': 'https://shorelineops.com',
    'logo': 'https://shorelineops.com/logo.png',
    'description': 'Healthcare clinical nutrition technology and institutional dietary operations software for senior living, assisted living, and skilled nursing facilities.',
    'address': {
      '@type': 'PostalAddress',
      'addressLocality': 'Portland',
      'addressRegion': 'ME',
      'postalCode': '04101',
      'addressCountry': 'US'
    },
    'geo': {
      '@type': 'GeoCoordinates',
      'latitude': '43.6591',
      'longitude': '-70.2568'
    }
  }
])
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — ShorelineOps Care OS</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Geolocation Meta Tags (Maine Coastal Senior Living Origin) -->
    <meta name="geo.region" content="US-ME" />
    <meta name="geo.placename" content="Portland, Maine" />
    <meta name="geo.position" content="43.6591;-70.2568" />
    <meta name="ICBM" content="43.6591, -70.2568" />

    <!-- OpenGraph Social Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ShorelineOps Care OS" />
    <meta property="og:title" content={`${title} — ShorelineOps Care OS`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={fullOgImageUrl} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ShorelineOps" />
    <meta name="twitter:creator" content="@ShorelineOps" />
    <meta name="twitter:title" content={`${title} — ShorelineOps Care OS`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImageUrl} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={schemaJson} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="bg-[#f5f5f7] dark:bg-slate-950 text-slate-900 dark:text-slate-100 font-sans antialiased selection:bg-blue-500 selection:text-white flex flex-col min-h-screen">
    <!-- Apple HIG Frosted Glass Header Navigation -->
    <header class="sticky top-0 z-50 border-b border-slate-200/80 dark:border-slate-800/80 bg-white/80 dark:bg-slate-950/80 backdrop-blur-2xl shadow-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 sm:h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <img
            src="/logo.png"
            alt="Shoreline Care OS"
            class="h-8 sm:h-9 w-auto object-contain group-hover:scale-105 transition-transform"
          />
          <span class="hidden sm:inline-block text-[10px] font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/80 px-2 py-0.5 rounded-full border border-blue-200/60 dark:border-blue-800/60 font-mono">OPEN SOURCE</span>
        </a>

        <nav class="hidden md:flex items-center gap-6 text-xs font-semibold text-slate-600 dark:text-slate-300">
          <a href="/#features" class="hover:text-blue-600 dark:hover:text-white transition-colors">Features</a>
          <a href="/#how-it-works" class="hover:text-blue-600 dark:hover:text-white transition-colors">How It Works</a>
          <a href="/pricing" class="hover:text-blue-600 dark:hover:text-white transition-colors">Pricing &amp; Plans</a>
          <a href="/distributors" class="hover:text-blue-600 dark:hover:text-white transition-colors">Distributors</a>
        </nav>

        <div class="flex items-center gap-2.5">
          <a
            href="https://github.com/ShadowWalkerNC/ShorelineOps"
            target="_blank"
            rel="noreferrer"
            class="text-xs font-semibold px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-slate-700 transition-all hidden sm:flex items-center gap-1.5 shadow-2xs"
          >
            <Icon name="github" class="w-3.5 h-3.5 text-slate-700 dark:text-slate-300" />
            <span>GitHub</span>
          </a>
          <a
            href={DEMO_URL}
            class="inline-flex items-center justify-center px-3.5 sm:px-4 py-1.5 sm:py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-500 rounded-xl transition-all shadow-sm shadow-blue-600/30 hover:scale-[1.02] active:scale-[0.98] gap-1.5"
          >
            <span>Try Demo</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <!-- Apple HIG Clean Footer -->
    <footer class="border-t border-slate-200/80 dark:border-slate-800/80 bg-white/60 dark:bg-slate-950/80 py-12 text-slate-500 dark:text-slate-400 text-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 mb-10">
        <div>
          <div class="flex items-center gap-2 mb-2.5">
            <img src="/logo.png" alt="ShorelineOps" class="w-6 h-6 rounded-lg object-contain" />
            <div class="font-bold text-sm text-slate-900 dark:text-white">ShorelineOps</div>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed mb-3">
            The open-source clinical nutrition & dietary operations platform built by an executive healthcare chef. Free community core software with managed enterprise SaaS.
          </p>
          <div class="text-[11px] text-slate-400 font-mono">Portland, ME · Healthcare Dietary Operations · Zero Vendor Lock-In</div>
        </div>

        <div>
          <div class="font-bold text-slate-900 dark:text-white text-[11px] uppercase tracking-wider mb-2.5 font-mono">Features</div>
          <ul class="space-y-1.5 text-xs">
            <li><a href="/#features" class="hover:text-blue-600 dark:hover:text-white transition-colors">Multi-Distributor Split MRP</a></li>
            <li><a href="/#features" class="hover:text-blue-600 dark:hover:text-white transition-colors">Digital Tray Card Scanner</a></li>
            <li><a href="/#features" class="hover:text-blue-600 dark:hover:text-white transition-colors">PointClickCare EHR Sync</a></li>
            <li><a href="/#features" class="hover:text-blue-600 dark:hover:text-white transition-colors">CMS-2567 Federal Survey Binder</a></li>
            <li><a href="/#features" class="hover:text-blue-600 dark:hover:text-white transition-colors">IDDSI Dysphagia Hard-Blocks</a></li>
          </ul>
        </div>

        <div>
          <div class="font-bold text-slate-900 dark:text-white text-[11px] uppercase tracking-wider mb-2.5 font-mono">Platform & SaaS</div>
          <ul class="space-y-1.5 text-xs">
            <li><a href="/pricing" class="hover:text-blue-600 dark:hover:text-white transition-colors">Free Core vs Managed SaaS</a></li>
            <li><a href="/distributors" class="hover:text-blue-600 dark:hover:text-white transition-colors">Dennis & Sysco Partner Portal</a></li>
            <li><a href={DEMO_URL} class="hover:text-blue-600 dark:hover:text-white transition-colors">Interactive Demo Web App</a></li>
            <li><a href="https://github.com/ShadowWalkerNC/ShorelineOps" class="hover:text-blue-600 dark:hover:text-white transition-colors">Self-Hosted Docker Stack</a></li>
          </ul>
        </div>

        <div>
          <div class="font-bold text-slate-900 dark:text-white text-[11px] uppercase tracking-wider mb-2.5 font-mono">Compliance & Legal</div>
          <ul class="space-y-1.5 text-xs">
            <li><a href="/terms" class="hover:text-blue-600 dark:hover:text-white transition-colors">Terms of Service & MSA</a></li>
            <li><a href="/privacy" class="hover:text-blue-600 dark:hover:text-white transition-colors">Healthcare Privacy & HIPAA BAA</a></li>
            <li><a href="/security" class="hover:text-blue-600 dark:hover:text-white transition-colors">Security Architecture & SLA</a></li>
            <li><a href="https://github.com/ShadowWalkerNC/ShorelineOps/blob/main/LICENSING.md" class="hover:text-blue-600 dark:hover:text-white transition-colors">Open Core License Architecture</a></li>
          </ul>
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-slate-200/80 dark:border-slate-800/60 pt-5 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400">
        <div>© 2026 Shoreline Operations LLC. Free Open Source Core under AGPL/MIT License.</div>
        <div class="mt-2 sm:mt-0 font-mono text-[11px]">Free Core Software · Enterprise Cloud SaaS · Maine Healthcare Tech</div>
      </div>
    </footer>
  </body>
</html>
