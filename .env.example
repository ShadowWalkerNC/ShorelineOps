# Shoreline — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and must NEVER be committed.

# Demo mode embeds local credentials in the client. NEVER enable with real PHI.
VITE_DEMO_MODE=false

# Backend API (used when VITE_DEMO_MODE is not true)
VITE_API_URL=http://localhost:3001/api

# Session idle timeout in ms (default 15 minutes)
# VITE_SESSION_TIMEOUT_MS=900000

# Optional Supabase (legacy / future) — publishable key only
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ⚠️  NEVER put the secret key here or in any frontend file.
