# ==============================================================================
# Shoreline Care OS — Environment Configuration Blueprint (.env.example)
# ==============================================================================
# Copy this file to .env before starting the development server or deployment.

# ------------------------------------------------------------------------------
# 1. Server & API Configuration
# ------------------------------------------------------------------------------
# Network port for Express backend API (default: 3001)
PORT=3001

# Application environment ('development' | 'production' | 'test')
NODE_ENV=development

# Secret key used for signing JWT authentication tokens (Must be 32+ characters in production)
JWT_SECRET=shoreline_jwt_secret_dev_32char_minimum_entropy_key_here

# Client URL allowed for CORS authentication and redirects
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database Persistence
# ------------------------------------------------------------------------------
# In local/offline mode, leave DATABASE_URL unset. The server automatically uses
# SQLite at server/shoreline.db with automatic migration sync.
# In cloud/production mode (Render, Supabase, Neon, AWS RDS), supply PostgreSQL URL:
# DATABASE_URL=postgres://user:password@host:5432/shoreline

# ------------------------------------------------------------------------------
# 3. Client Frontend (Vite)
# ------------------------------------------------------------------------------
# Base API URL consumed by the React 18 frontend
VITE_API_URL=http://localhost:3001

# Sandbox demo mode ('true' enables pre-seeded accounts and sandbox bypass)
VITE_DEMO_MODE=true

# ------------------------------------------------------------------------------
# 4. Commercial SaaS Licensing & Feature Gating
# ------------------------------------------------------------------------------
# Optional cryptographic license key for Pro/Enterprise tier features:
# - Pro tier: SH_PRO_... (enables Multi-Distributor Split MRP, PCC Live Sync)
# - Enterprise: SH_ENT_... (enables CMS-2567 Survey Binder, 3-Way Match, Syndication)
# Leave blank for Community Core tier (unlimited beds, local offline forever)
SHORELINE_LICENSE_KEY=

# ------------------------------------------------------------------------------
# 5. External Clinical & Distributor Integrations (Enterprise Optional)
# ------------------------------------------------------------------------------
# PointClickCare OAuth credentials (FHIR R4 Census & Diet Order Sync)
PCC_CLIENT_ID=
PCC_CLIENT_SECRET=
PCC_REDIRECT_URI=http://localhost:3001/api/ehr/callback

# USDA FoodData Central API Key (for automated micronutrient solving)
USDA_API_KEY=DEMO_KEY

# Stripe SaaS Billing Webhook Secret (for automated license issuance)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
