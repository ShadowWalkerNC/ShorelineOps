# Shoreline — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and must NEVER be committed.
#
# Get these values from:
# Supabase Dashboard → Project Settings → API

# Project URL (e.g. https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable / anon key — safe for frontend use
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ⚠️  NEVER put the secret key here or in any frontend file.
# The secret key belongs only in server/.env or your hosting platform's
# environment secrets, never in the Vite/React app.
