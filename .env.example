# ==============================================================================
# ShorelineOps — Environment Configuration Guide (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local and configure your environment.
# ⚠️ NEVER commit real secrets or production passwords to version control.

# --- Application Runtime & Ports ---
NODE_ENV=production
PORT=3001
FRONTEND_URL=http://localhost:3001

# --- Security & JWT Authentication (MANDATORY IN PRODUCTION) ---
# Must be a cryptographically secure random string with minimum 32 characters.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_hex_key_at_least_32_characters_long

# Session inactivity timeout in ms (default: 10 minutes = 600,000 ms for HIPAA compliance)
VITE_SESSION_TIMEOUT_MS=600000

# --- Production Database (PostgreSQL) ---
# Connection string format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://shoreline:your_secure_password@localhost:5432/shorelineops

# SSL Certificate validation for managed databases (e.g. Supabase, AWS RDS, Neon, Railway)
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --- Default Super Admin Seeding (First-time initialization) ---
SEED_ADMIN_EMAIL=admin@shorelineops.local
SEED_ADMIN_PASSWORD=ComplexAdminPass2026!

# --- External API Integrations (Optional) ---
# USDA FoodData Central API key for automated ingredient nutrient breakdown:
USDA_FDC_API_KEY=DEMO_KEY

# PointClickCare Clinical EHR Integration Credentials:
PCC_BASE_URL=https://api.pointclickcare.com
PCC_CLIENT_ID=your_pcc_client_id
PCC_CLIENT_SECRET=your_pcc_client_secret
PCC_FACILITY_ID=your_facility_id

# --- Client-Side Flags (Vite) ---
# Set to false in production. Never enable demo mode with real resident PHI.
VITE_DEMO_MODE=false
VITE_API_URL=/api
