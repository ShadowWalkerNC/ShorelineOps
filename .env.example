# ShorelineOps environment template
# Production uses the Express API and PostgreSQL as the only system of record.
# Do not configure browser Supabase keys; the production SPA never connects
# directly to the database.

# API runtime
NODE_ENV=production
PORT=3001
# One facility per database. Must match the accounts' facility_id.
# A shared multi-facility clinical database is not supported.
SHORELINE_FACILITY_ID=default
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=GENERATE_A_UNIQUE_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
FRONTEND_URL=https://YOUR_APP_HOST
PLATFORM_OWNER_EMAIL=owner@example.com
LICENSE_SIGNING_SECRET=GENERATE_A_SEPARATE_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS

# Initial bootstrap only. Remove or rotate after setup is complete.
SETUP_BOOTSTRAP_SECRET=GENERATE_A_UNIQUE_RANDOM_BOOTSTRAP_SECRET

# Browser build
# Use /api for the unified Railway service, or a complete API base ending /api.
VITE_API_URL=/api
VITE_DEMO_MODE=false
VITE_SESSION_TIMEOUT_MS=900000

# Public marketing links
PUBLIC_DEMO_URL=https://YOUR_DEMO_HOST/
PUBLIC_APP_URL=https://YOUR_APP_HOST/app/

# Optional integrations. Missing values keep the integration disabled.
EHR_WEBHOOK_SECRET=
PCC_CLIENT_ID=
PCC_CLIENT_SECRET=
PCC_FACILITY_ID=
STRIPE_WEBHOOK_SECRET=
USDA_FDC_API_KEY=
KIOSK_API_SECRET=
AOD_KIOSK_URL=
AOD_KIOSK_IDENTIFIER=
AOD_TZ=

# Local/offline development only
# SQLITE_PATH=./server/shoreline.db
# SHORELINE_DEMO_SEED=true
