# ==============================================================================
# Shoreline Care OS — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or set these in your hosting provider (Vercel, Render, Railway, Supabase).
# For Vercel: add VITE_* variables in Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. CLIENT APPLICATION (Vercel / Vite SPA — src/)
# ------------------------------------------------------------------------------
# API Backend Base URL (e.g. https://api.shorelineops.com/api or /api if proxied)
VITE_API_URL=https://api.shorelineops.com/api

# Enable pre-seeded demo sandbox data (true on demo instances; false in production)
VITE_DEMO_MODE=false

# Clinical / Enterprise SaaS license key (leave empty for Open Core tier)
VITE_SHORELINE_LICENSE_KEY=SH_ENT_demo_preview_token

# Inactivity auto-logout duration in milliseconds (default: 900,000 = 15 minutes)
VITE_SESSION_TIMEOUT_MS=900000

# ------------------------------------------------------------------------------
# 2. SUPABASE INTEGRATION (Frontend Client)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key (safe for browser exposure)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------------------------
# 3. MARKETING SITE (Astro — marketing/)
# ------------------------------------------------------------------------------
# Link from marketing CTAs ("Launch App", "Interactive Demo") to your hosted app
PUBLIC_DEMO_URL=https://app.shorelineops.com
PUBLIC_APP_URL=https://app.shorelineops.com

# Optional: Supabase credentials for marketing waitlist or contact lead capture
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------------------------
# 4. BACKEND API SERVER (Node.js / Express — server/)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3001

# Cryptographically random string (min 32 chars) for signing session JWTs
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_cryptographically_secure_random_32_char_secret_key!

# Primary frontend URL for CORS policy
FRONTEND_URL=https://app.shorelineops.com

# ------------------------------------------------------------------------------
# 5. DATABASE CONFIGURATION (Supabase PostgreSQL / Managed Postgres)
# ------------------------------------------------------------------------------
# Supabase PostgreSQL Connection String (Found in Supabase -> Settings -> Database -> Connection string)
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your_db_password@db.your-project-id.supabase.co:5432/postgres

# Required 'false' for managed Supabase/Neon transaction poolers
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Optional: Local SQLite file path when running offline or in edge mode
# SQLITE_PATH=./server/shoreline.db

# ------------------------------------------------------------------------------
# 6. SUPABASE SERVICE / ADMINISTRATIVE (Backend only — never expose to client!)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Master setup bootstrap secret (used for initial facility provisioning)
SETUP_BOOTSTRAP_SECRET=shoreline-bootstrap-dev-secret-2026

# ------------------------------------------------------------------------------
# 7. THIRD-PARTY PARTNER INTEGRATIONS (Optional / Enterprise)
# ------------------------------------------------------------------------------
# Stripe Billing & SaaS Subscription
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# PointClickCare (PCC) EHR Live Sync
PCC_CLIENT_ID=
PCC_CLIENT_SECRET=
PCC_FACILITY_ID=
EHR_WEBHOOK_SECRET=

# USDA FoodData Central (Master Nutrient Solver)
USDA_FDC_API_KEY=DEMO_KEY
