FROM node:22-slim

WORKDIR /app

ARG VITE_DEMO_MODE=true
ARG VITE_API_URL=https://shoreline-api-production.up.railway.app/api
ENV VITE_DEMO_MODE=${VITE_DEMO_MODE}
ENV VITE_API_URL=${VITE_API_URL}

COPY package*.json ./
RUN npm ci

COPY . .
RUN npx vite build --base=/

EXPOSE 4173
CMD ["sh", "-c", "npm run preview:demo -- --host 0.0.0.0 --port ${PORT:-4173}"]
