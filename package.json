{
  "name": "shoreline-v5",
  "version": "5.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:demo": "VITE_MODE=demo vite",
    "dev:web": "VITE_MODE=web vite",
    "build": "tsc && vite build",
    "build:local": "VITE_MODE=local tsc && VITE_MODE=local vite build --outDir dist/local",
    "build:demo": "VITE_MODE=demo tsc && VITE_MODE=demo vite build --outDir dist/demo",
    "build:web": "VITE_MODE=web tsc && VITE_MODE=web vite build --outDir dist/web",
    "build:all": "npm run build:local && npm run build:demo && npm run build:web",
    "preview": "vite preview",
    "preview:local": "vite preview --outDir dist/local",
    "preview:demo": "vite preview --outDir dist/demo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.4",
    "axios": "^1.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^0.20.0",
    "workbox-window": "^7.1.0"
  }
}
