{
  "name": "shoreline-v5",
  "version": "5.0.0",
  "private": true,
  "main": "electron-main.js",
  "bin": {
    "shoreline": "./bin/shoreline.js",
    "culinaryos": "./bin/shoreline.js"
  },
  "workspaces": [
    "server",
    "marketing"
  ],
  "scripts": {
    "cli": "node bin/shoreline.js",
    "dev": "vite",
    "dev:all": "concurrently \"npm run dev\" \"npm --prefix server run dev\"",
    "build": "tsc && vite build",
    "build:demo": "tsc && vite build",
    "build:marketing": "npm --prefix marketing run build",
    "build:all": "npm run build && npm --prefix server run build && npm --prefix marketing run build",
    "build:installer": "node installer/build_installer.js",
    "setup:local": "powershell -ExecutionPolicy Bypass -File Setup.ps1",
    "launch": "node launcher.js",
    "start": "node server/dist/index.js",
    "test": "node server/dist/system.test.js",
    "drill:failure": "node scripts/meal_service_failure_drill.js",
    "audit:operations": "node scripts/operations_consultant_audit.js",
    "preview": "vite preview",
    "preview:demo": "vite preview",
    "preview:marketing": "npm --prefix marketing run preview",
    "typecheck": "tsc --noEmit",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"electron .\""
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@supabase/supabase-js": "^2.43.4",
    "axios": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.5",
    "electron": "^43.3.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^0.20.0",
    "workbox-window": "^7.1.0"
  }
}
