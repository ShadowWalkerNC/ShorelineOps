{
  "buildCommand": "node scripts/build_unified_site.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/demo/index.html"
    },
    {
      "source": "/demo/:path*",
      "destination": "/demo/index.html"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    }
  ]
}
