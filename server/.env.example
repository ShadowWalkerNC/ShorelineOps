# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL) — required in production
DATABASE_URL=postgresql://user:password@localhost:5432/shoreline
# Only set to false for managed DBs that require it (prefer proper CA verification)
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# JWT — REQUIRED (≥32 characters). Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret-at-least-64-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# First-time facility setup — REQUIRED to call POST /api/setup/initialize
SETUP_BOOTSTRAP_SECRET=change-me-setup-secret-min-16

# Kiosk webhook — REQUIRED for POST /api/timecard/webhook
KIOSK_API_SECRET=change-me-kiosk-secret-min-16

# Optional Attendance on Demand bridge (omit to log punches locally only)
# AOD_KIOSK_URL=https://your-tenant.attendanceondemand.com/kiosk/MAINPAGE
# AOD_KIOSK_IDENTIFIER=Default
# AOD_TZ=240

# Seed (development only). Production skips seed unless ALLOW_AUTO_SEED=true
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=ChangeMeStrong1!
# SEED_SAMPLE_RESIDENTS=true
# ALLOW_AUTO_SEED=false
