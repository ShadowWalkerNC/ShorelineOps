# ==============================================================================
# Shoreline Care OS — Backend Server Environment (.env.example)
# ==============================================================================

PORT=3001
NODE_ENV=development
JWT_SECRET=shoreline_jwt_secret_dev_32char_minimum_entropy_key_here
FRONTEND_URL=http://localhost:5173

# Database (leave blank for local SQLite at server/shoreline.db)
# DATABASE_URL=postgres://user:password@host:5432/shoreline

# Optional license key (Pro: SH_PRO_..., Enterprise: SH_ENT_...)
SHORELINE_LICENSE_KEY=

# Optional external integrations
PCC_CLIENT_ID=
PCC_CLIENT_SECRET=
PCC_REDIRECT_URI=http://localhost:3001/api/ehr/callback
USDA_API_KEY=DEMO_KEY
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
